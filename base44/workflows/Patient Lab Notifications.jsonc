{
  "name": "Patient Lab Notifications",
  "description": "Notifies the patient when a doctor sends a laboratory request or when laboratory results become available",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "LabRequest",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.event_type == \"create\" or (.trigger.data.status == \"results\" and .trigger.old_data.status != \"results\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "patient_lab_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_patient": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPatientLabEvent",
            "args": {
              "lab_request_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify patient",
            "description": "New request or results ready"
          }
        }
      }
    ]
  }
}