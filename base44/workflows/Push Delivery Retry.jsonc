{
  "description": "Re-attempts Web Push deliveries that failed temporarily (push service unreachable or rate limiting). Runs every 10 minutes; expired subscriptions are never retried.",
  "name": "Push Delivery Retry",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "Africa/Tripoli",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_delivery_retry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "retry_pushes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushSend",
            "args": {
              "mode": "retry"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Retry queued push deliveries"
          }
        }
      }
    ]
  }
}