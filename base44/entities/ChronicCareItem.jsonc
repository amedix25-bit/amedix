{
  "name": "ChronicCareItem",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the chronic care / device entry belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "implanted_device",
        "prosthesis",
        "dialysis",
        "home_oxygen",
        "mobility_aid",
        "sensory_assistance",
        "accessibility_requirement",
        "care_plan",
        "advance_directive",
        "other"
      ],
      "description": "Implanted medical devices (including pacemakers), prostheses and surgical implants, dialysis status, home oxygen or other ongoing medical support, mobility aids, hearing/visual assistance, communication or accessibility requirements, care plans for chronic conditions, advance directives or documented care preferences, or other"
    },
    "title": {
      "type": "string",
      "description": "The device, support or plan, e.g. 'Pacemaker', 'Hearing aid', 'Home oxygen'"
    },
    "details": {
      "type": "string",
      "description": "Any relevant details"
    }
  },
  "required": [
    "patient_id",
    "item_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}