{
  "name": "MedicalTranslation",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the translated text belongs to"
    },
    "direction": {
      "type": "string",
      "enum": [
        "patient_to_doctor",
        "doctor_to_patient"
      ],
      "description": "Display direction of the translation. PATIENT_TO_DOCTOR: Arabic text the patient entered, translated to English for the Doctor Portal. DOCTOR_TO_PATIENT: English text a doctor entered, translated to Arabic for the Patient Portal. Legacy records have no direction and are always patient_to_doctor."
    },
    "source_text": {
      "type": "string",
      "description": "The original text being translated \u2014 always preserved exactly as entered"
    },
    "translated_text": {
      "type": "string",
      "description": "Generated translation for display only \u2014 English for doctor display, Arabic for patient display"
    },
    "created_datetime": {
      "type": "string",
      "description": "Date and time the translation was generated (ISO datetime)"
    }
  },
  "required": [
    "patient_id",
    "source_text",
    "translated_text"
  ]
}