{
  "name": "PharmacyProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "pharmacy_name": {
      "type": "string",
      "description": "Pharmacy name"
    },
    "pharmacy_number": {
      "type": "string",
      "description": "A&M Pharmacy Number / ID \u2014 unique system-generated pharmacy identification number, e.g. AMP-2026-8F3K"
    },
    "address": {
      "type": "string",
      "description": "Pharmacy location / address"
    },
    "phone": {
      "type": "string",
      "description": "Pharmacy phone number"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "Pharmacy WhatsApp number"
    },
    "email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Pharmacy profile picture / logo"
    },
    "operating_hours": {
      "type": "string",
      "description": "Pharmacy operating hours, e.g. 9:00 to 22:00 daily"
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Payment methods the pharmacy accepts \u2014 cash, card, bank_transfer, insurance, mobile_wallet, other"
    },
    "receipt_note": {
      "type": "string",
      "description": "Custom note printed on the pharmacy's payment receipts"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 10,
      "description": "Stock level at or below which an inventory item is flagged as low stock in the dashboard and reports"
    },
    "settings_history": {
      "type": "array",
      "description": "Traceable history of every important settings change \u2014 field, previous value, new value, who changed it and when",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "datetime": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "datetime"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending_approval"
      ],
      "default": "active",
      "description": "Pharmacy account status \u2014 only 'active' pharmacies are shown to doctors and patients. An administrator can suspend a pharmacy to hide it from search and availability results."
    }
  },
  "required": [
    "user_id",
    "pharmacy_name",
    "pharmacy_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}