{
  "name": "Medication",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "dose": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "intravenous",
        "intramuscular",
        "subcutaneous",
        "topical",
        "inhalation",
        "rectal",
        "other"
      ]
    },
    "meal_timing": {
      "type": "string",
      "enum": [
        "before_meal",
        "after_meal",
        "with_meal",
        "anytime",
        "unknown"
      ],
      "description": "Whether the medication is taken before or after meals"
    },
    "duration": {
      "type": "string",
      "description": "Prescribed duration, e.g. '14 days'"
    },
    "prn": {
      "type": "boolean",
      "default": false,
      "description": "PRN \u2014 take as needed rather than on a fixed schedule"
    },
    "max_frequency": {
      "type": "string",
      "description": "Maximum frequency for PRN medications, e.g. 'Max 3 times daily'"
    },
    "doctor_notes": {
      "type": "string",
      "description": "Notes / instructions from the prescribing doctor"
    },
    "special_instructions": {
      "type": "string",
      "description": "Special instructions from the doctor for the patient to follow"
    },
    "patient_notes": {
      "type": "string",
      "description": "Additional notes entered by the patient (patient-reported medications)"
    },
    "source": {
      "type": "string",
      "enum": [
        "doctor_prescribed",
        "patient_reported"
      ],
      "default": "patient_reported",
      "description": "Whether the medication was prescribed by a doctor or reported by the patient"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Automatically calculated from start date + duration. The medication becomes inactive once this date passes."
    },
    "reason": {
      "type": "string",
      "description": "Indication / reason for the medication"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the medication is currently active. Set to false when a doctor stops the medication or when the prescribed duration ends."
    },
    "stopped_date": {
      "type": "string",
      "format": "date",
      "description": "Date the medication was stopped"
    }
  },
  "required": [
    "patient_id",
    "name"
  ]
}