{
  "name": "Medication",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "dose": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "intravenous",
        "intramuscular",
        "subcutaneous",
        "topical",
        "inhalation",
        "rectal",
        "other"
      ]
    },
    "duration": {
      "type": "string",
      "description": "Prescribed duration, e.g. '14 days'"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Automatically calculated from start date + duration. The medication becomes inactive once this date passes."
    },
    "reason": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the medication is currently active. Set to false when a doctor stops the medication or when the prescribed duration ends."
    },
    "stopped_date": {
      "type": "string",
      "format": "date",
      "description": "Date the medication was stopped"
    }
  },
  "required": [
    "patient_id",
    "name"
  ]
}