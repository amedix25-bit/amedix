{
  "name": "Medication",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security. Set server-side only: medications are created exclusively through the backend clinical flow (patients add their own reported medications, doctors prescribe only when the patient is checked in), never directly from a client."
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Active ingredient (generic name), when known \u2014 used for duplicate-therapy detection in medication reconciliation"
    },
    "prescription_id": {
      "type": "string",
      "description": "Prescription record id this medication entry was created from, when applicable \u2014 links the reported medication to its prescription and dispensing history"
    },
    "dose": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "intravenous",
        "intramuscular",
        "subcutaneous",
        "topical",
        "inhalation",
        "rectal",
        "other"
      ]
    },
    "meal_timing": {
      "type": "string",
      "enum": [
        "before_meal",
        "after_meal",
        "with_meal",
        "anytime",
        "unknown"
      ],
      "description": "Whether the medication is taken before or after meals"
    },
    "duration": {
      "type": "string",
      "description": "Prescribed duration, e.g. '14 days'"
    },
    "prn": {
      "type": "boolean",
      "default": false,
      "description": "PRN \u2014 take as needed rather than on a fixed schedule"
    },
    "max_frequency": {
      "type": "string",
      "description": "Maximum frequency for PRN medications, e.g. 'Max 3 times daily'"
    },
    "doctor_notes": {
      "type": "string",
      "description": "Notes / instructions from the prescribing doctor"
    },
    "special_instructions": {
      "type": "string",
      "description": "Special instructions from the doctor for the patient to follow"
    },
    "patient_notes": {
      "type": "string",
      "description": "Additional notes entered by the patient (patient-reported medications)"
    },
    "source": {
      "type": "string",
      "enum": [
        "doctor_prescribed",
        "patient_reported"
      ],
      "default": "patient_reported",
      "description": "Whether the medication was prescribed by a doctor or reported by the patient"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Automatically calculated from start date + duration. The medication becomes inactive once this date passes."
    },
    "reason": {
      "type": "string",
      "description": "Indication / reason for the medication"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the medication is currently active. Set to false when a doctor stops the medication or when the prescribed duration ends."
    },
    "stopped_date": {
      "type": "string",
      "format": "date",
      "description": "Date the medication was stopped"
    },
    "stop_reason": {
      "type": "string",
      "description": "Documented reason the medication was stopped \u2014 entered by the doctor during medication reconciliation or by the patient when reporting a change"
    }
  },
  "required": [
    "patient_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}