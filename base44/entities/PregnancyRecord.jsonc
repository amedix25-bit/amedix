{
  "name": "PregnancyRecord",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security so the patient can read their own pregnancy record"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "lost_to_followup"
      ],
      "default": "active",
      "description": "Pregnancy record status"
    },
    "lmp_date": {
      "type": "string",
      "format": "date",
      "description": "Last menstrual period (LMP) \u2014 the documented pregnancy dating information"
    },
    "edd_date": {
      "type": "string",
      "format": "date",
      "description": "Estimated due date (EDD) \u2014 calculated from LMP (Naegele) or recorded directly"
    },
    "dating_method": {
      "type": "string",
      "enum": [
        "lmp",
        "ultrasound",
        "edd",
        "clinical_assessment"
      ],
      "default": "lmp",
      "description": "How the pregnancy was dated \u2014 LMP, ultrasound, EDD or clinical assessment. A recorded ultrasound dating measurement overrides the LMP estimate"
    },
    "ultrasound_dating_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the ultrasound examination used for dating, when applicable"
    },
    "ultrasound_dating_weeks": {
      "type": "integer",
      "description": "Completed weeks of gestation measured at the dating ultrasound"
    },
    "ultrasound_dating_days": {
      "type": "integer",
      "description": "Additional days of gestation measured at the dating ultrasound"
    },
    "dating_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "lmp_date": {
            "type": "string",
            "format": "date"
          },
          "edd_date": {
            "type": "string",
            "format": "date"
          },
          "dating_method": {
            "type": "string"
          },
          "ultrasound_dating_date": {
            "type": "string",
            "format": "date"
          },
          "ultrasound_dating_weeks": {
            "type": "integer"
          },
          "ultrasound_dating_days": {
            "type": "integer"
          },
          "reason": {
            "type": "string",
            "description": "Documented reason for the dating adjustment"
          },
          "by_user_id": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "reason"
        ]
      },
      "description": "Previous pregnancy dating adjustments with their documented reasons and who made them. Dating changes recalculate the recommended schedule while preserving existing orders, results and completed investigations \u2014 completed items are never automatically repeated"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contact_no": {
            "type": "integer",
            "description": "1-8 for the standard contact schedule, or the sequence number of an additional contact"
          },
          "additional": {
            "type": "boolean",
            "default": false,
            "description": "True for an additional contact beyond the standard schedule \u2014 supported for high-risk pregnancies and other clinical indications, with a documented reason"
          },
          "additional_reason": {
            "type": "string",
            "description": "Documented clinical indication for an additional contact (required for additional contacts)"
          },
          "week": {
            "type": "integer",
            "description": "Gestational week at which the contact was documented"
          },
          "completed_datetime": {
            "type": "string",
            "description": "ISO datetime the qualifying antenatal encounter was documented. A contact counts as completed ONLY when this qualifying encounter documentation exists \u2014 reminders and ordered investigations never complete a contact"
          },
          "completed_by_name": {
            "type": "string",
            "description": "Clinician who documented the contact"
          },
          "completed_by_user_id": {
            "type": "string"
          },
          "encounter_evidence": {
            "type": "string",
            "description": "Documented evidence of the qualifying encounter \u2014 clinical note reference, encounter ID or the documented antenatal review"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "contact_no",
          "completed_datetime",
          "encounter_evidence"
        ]
      },
      "description": "Recorded antenatal contacts \u2014 one entry per documented contact encounter. Completed contacts, the next recommended contact and missed/overdue contacts are derived from this list together with the gestational age"
    },
    "risk_assessment": {
      "type": "object",
      "additionalProperties": true,
      "description": "Latest structured maternal risk assessment \u2014 { assessed_datetime, by_name, level, factor_keys, rules_source, rules_version } \u2014 assigned by an authorized clinician on top of the traced, rule-based factor evaluation. Risk classification is always a clinician decision; the system never assigns a level automatically"
    },
    "alert_acks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_key": {
            "type": "string"
          },
          "acknowledged_datetime": {
            "type": "string",
            "description": "ISO datetime the alert was acknowledged"
          },
          "by_name": {
            "type": "string"
          },
          "action_taken": {
            "type": "string",
            "description": "Documented action taken in response to the alert"
          }
        },
        "required": [
          "rule_key",
          "acknowledged_datetime",
          "action_taken"
        ]
      },
      "description": "Clinical decision-support alert acknowledgements \u2014 rule key, who acknowledged, when, and the documented action taken. Acknowledged alerts stop repeating so reminders are not duplicated"
    },
    "gravida": {
      "type": "integer"
    },
    "parity": {
      "type": "integer"
    },
    "previous_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "description": "e.g. live birth, stillbirth, miscarriage, ectopic pregnancy, termination"
          },
          "year": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Documented previous pregnancy outcomes"
    },
    "previous_cesarean": {
      "type": "boolean",
      "default": false,
      "description": "Previous cesarean delivery"
    },
    "previous_preeclampsia": {
      "type": "boolean",
      "default": false,
      "description": "Previous pre-eclampsia \u2014 a documented risk factor for hypertensive disorders in this pregnancy"
    },
    "previous_gestational_diabetes": {
      "type": "boolean",
      "default": false,
      "description": "Previous gestational diabetes"
    },
    "previous_preterm_birth": {
      "type": "boolean",
      "default": false,
      "description": "Previous preterm birth"
    },
    "previous_fgr": {
      "type": "boolean",
      "default": false,
      "description": "Previous fetal growth restriction"
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "medical / obstetric / lifestyle / psychosocial / family"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "description": "Documented maternal risk factors recorded by clinicians"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "high",
        "intermediate",
        "low",
        "pending_assessment"
      ],
      "default": "pending_assessment",
      "description": "Clinician-assigned pregnancy risk level \u2014 never assigned automatically; a pregnancy with missing information remains pending_assessment"
    },
    "risk_level_reason": {
      "type": "string"
    },
    "risk_level_datetime": {
      "type": "string"
    },
    "risk_level_by_name": {
      "type": "string"
    },
    "initial_assessment_done": {
      "type": "boolean",
      "default": false,
      "description": "True once the initial antenatal booking assessment is documented. If the patient reaches 12 weeks without it, the outstanding assessments are flagged for clinician review"
    },
    "initial_assessment_datetime": {
      "type": "string"
    },
    "last_clinical_review_datetime": {
      "type": "string",
      "description": "Date and time of the latest clinical review (ISO datetime)"
    },
    "last_reviewed_by_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "patient_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}