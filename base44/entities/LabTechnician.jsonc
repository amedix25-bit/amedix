{
  "name": "LabTechnician",
  "type": "object",
  "properties": {
    "laboratory_id": {
      "type": "string"
    },
    "laboratory_user_id": {
      "type": "string",
      "description": "User id of the laboratory owner account \u2014 validated at creation so technician accounts can only be registered for the owner's own laboratory"
    },
    "laboratory_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "age": {
      "type": "string"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "job_title": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "description": "Unique technician login username"
    },
    "password_hash": {
      "type": "string",
      "description": "SHA-256 hash of the technician's password (salted)"
    },
    "salt": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "session_token": {
      "type": "string",
      "description": "Active session token issued at login \u2014 required for all technician actions"
    }
  },
  "required": [
    "laboratory_id",
    "full_name",
    "job_title",
    "username",
    "password_hash",
    "salt"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.laboratory_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.laboratory_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.laboratory_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.laboratory_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}