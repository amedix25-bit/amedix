{
  "name": "DoctorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "specialization": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "hospital": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Doctor profile picture \u2014 uploaded by the doctor, shown wherever the doctor appears to other users"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "full_name",
    "specialization",
    "license_number"
  ]
}