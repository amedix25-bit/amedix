{
  "name": "DoctorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "Doctor's first name"
    },
    "middle_name": {
      "type": "string",
      "description": "Doctor's middle name"
    },
    "last_name": {
      "type": "string",
      "description": "Doctor's last name"
    },
    "name_edited": {
      "type": "boolean",
      "default": false,
      "description": "True once the doctor has set or confirmed their name \u2014 controls whether the one-time name edit is still available"
    },
    "specialization": {
      "type": "string",
      "description": "The doctor's active primary specialty from the predefined list \u2014 drives the specialty-specific clinical documentation shown by default (Surgeons get Surgical Records)"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All of the doctor's verified specialties from the predefined list. A doctor with more than one verified specialty selects the specialty they are practicing for each encounter \u2014 the selection is saved to that encounter and applies to all documents created during it. The active specialty is mirrored in `specialization`."
    },
    "license_number": {
      "type": "string"
    },
    "hospital": {
      "type": "string",
      "description": "The hospital the doctor is currently working at \u2014 selected by the doctor from their verified hospital associations and used by the check-in security gate to match active check-ins. Clinical notes, lab requests and imaging requests are associated with this hospital."
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Doctor profile picture \u2014 uploaded by the doctor, shown wherever the doctor appears to other users"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "last_active_datetime": {
      "type": "string",
      "description": "Date and time of the doctor's last activity in the Doctor Portal (ISO datetime) \u2014 refreshed while the portal is open and powers the Online/Offline status in the hospital's Manage Doctors view"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "specialization",
    "license_number"
  ]
}