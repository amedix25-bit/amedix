{
  "name": "DoctorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "Doctor's first name"
    },
    "middle_name": {
      "type": "string",
      "description": "Doctor's middle name"
    },
    "last_name": {
      "type": "string",
      "description": "Doctor's last name"
    },
    "name_edited": {
      "type": "boolean",
      "default": false,
      "description": "True once the doctor has set or confirmed their name \u2014 controls whether the one-time name edit is still available"
    },
    "specialization": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "hospital": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Doctor profile picture \u2014 uploaded by the doctor, shown wherever the doctor appears to other users"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "full_name",
    "specialization",
    "license_number"
  ]
}