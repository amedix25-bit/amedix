{
  "name": "ImagingRequest",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security. Set when the doctor creates the request."
    },
    "doctor_id": {
      "type": "string"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the requesting doctor account \u2014 set server-side when the request is created, used for Row Level Security so the doctor can see and manage the requests they sent"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_specialization": {
      "type": "string",
      "description": "Specialty of the requesting doctor"
    },
    "doctor_hospital": {
      "type": "string",
      "description": "Hospital / clinic of the requesting doctor"
    },
    "request_id": {
      "type": "string",
      "description": "Unique imaging request reference, e.g. IR-20260907-8F3K"
    },
    "scan_type": {
      "type": "string",
      "enum": [
        "X-Ray",
        "CT",
        "MRI",
        "Ultrasound",
        "Mammography",
        "Other"
      ],
      "description": "Type of imaging (modality)"
    },
    "examination": {
      "type": "string",
      "description": "Examination / view requested for the selected modality"
    },
    "body_part": {
      "type": "string",
      "description": "Legacy field \u2014 kept in sync with the examination"
    },
    "clinical_indication": {
      "type": "string",
      "description": "Why the imaging is being requested \u2014 relevant clinical information"
    },
    "working_diagnosis": {
      "type": "string",
      "description": "Working diagnosis / clinical question for the radiologist"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Routine",
        "Urgent",
        "Emergency"
      ],
      "default": "Routine",
      "description": "Priority of the request"
    },
    "requested_date": {
      "type": "string",
      "description": "Scheduling preference from the referring doctor \u2014 preferred date for the examination, where supported. Advisory only; the department sets the actual schedule"
    },
    "contrast": {
      "type": "string",
      "enum": [
        "No contrast",
        "With contrast",
        "With and without contrast",
        "Not applicable"
      ],
      "description": "Contrast use for the examination"
    },
    "contrast_allergy": {
      "type": "string",
      "enum": [
        "No known allergy",
        "Known allergy",
        "Unknown"
      ],
      "description": "Contrast allergy status"
    },
    "previous_contrast_reaction": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Previous contrast reaction"
    },
    "mri_metal_implant": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 metal or metallic implant in the body"
    },
    "mri_pacemaker": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 pacemaker or implanted cardiac device"
    },
    "mri_other_device": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 other implanted medical device"
    },
    "mri_metallic_foreign_body": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 possible metallic foreign body, especially in the eye"
    },
    "mri_other_concern": {
      "type": "string",
      "description": "MRI safety \u2014 other concern (free text)"
    },
    "request_datetime": {
      "type": "string",
      "description": "Date and time the request was created (ISO datetime)"
    },
    "request_time": {
      "type": "string",
      "description": "Time the request was created (HH:MM)"
    },
    "encounter_id": {
      "type": "string",
      "description": "Encounter reference the imaging request belongs to in the longitudinal AMedix Patient Record, e.g. ENC-20260916-8F3K \u2014 set when the request is created from an encounter"
    },
    "authorized_radiologist_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids of radiologists the PATIENT authorized for THIS SPECIFIC request only. Added server-side when the patient accepts the radiologist's access request \u2014 this is the Row Level Security gate for radiologist reads. Never grants access to the rest of the patient's record."
    },
    "routed_hospital_user_id": {
      "type": "string",
      "description": "User id of the hospital administrator whose facility the request is routed to \u2014 the facility's RADIOLOGY DEPARTMENT, resolved server-side from the doctor's hospital at creation. The department worklist is keyed on this field; requests are never routed to an individual radiologist."
    },
    "routed_hospital": {
      "type": "string",
      "description": "Name of the facility the request was routed to (the radiology department's hospital)"
    },
    "assigned_radiologist_user_id": {
      "type": "string",
      "description": "User id of the radiologist the department internally assigned this study to \u2014 optional; set by the department coordinator or via a radiologist claim. Never set at request creation."
    },
    "assigned_radiologist_name": {
      "type": "string",
      "description": "Name of the assigned radiologist"
    },
    "assigned_datetime": {
      "type": "string",
      "description": "Date and time the study was assigned (ISO datetime)"
    },
    "assignment_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "assigned / claimed / unassigned / reassigned"
          },
          "radiologist_user_id": {
            "type": "string"
          },
          "radiologist_name": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "datetime": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "datetime"
        ]
      },
      "description": "Internal study assignment history \u2014 every assign / claim / unassign / reassignment with who, when and why"
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "requested",
        "under_review",
        "clarification_required",
        "accepted",
        "scheduled",
        "in_progress",
        "performed",
        "examination_completed",
        "images_awaiting_transfer",
        "ready_for_reporting",
        "interpretation",
        "reporting_in_progress",
        "final_report",
        "released",
        "cancelled"
      ],
      "default": "requested",
      "description": "Radiology workflow stage \u2014 Submitted (requested) \u2192 Under Departmental Review \u2192 Accepted (or Clarification Required) \u2192 Scheduled \u2192 Examination In Progress \u2192 Examination Completed \u2192 Images Awaiting Transfer \u2192 Ready for Reporting \u2192 Reporting In Progress \u2192 Report Finalized \u2192 Released; Cancelled is possible from any active stage. Legacy records may hold 'performed' (\u2248 examination_completed) or 'interpretation' (\u2248 reporting_in_progress). Every transition is timestamped and recorded in the Audit Log."
    },
    "under_review_datetime": {
      "type": "string",
      "description": "Date and time the department moved the request under review (ISO datetime)"
    },
    "clarification_datetime": {
      "type": "string",
      "description": "Date and time the department requested clarification (ISO datetime)"
    },
    "clarification_request": {
      "type": "string",
      "description": "Clarification the department asked the referring doctor for"
    },
    "clarification_response": {
      "type": "string",
      "description": "The referring doctor's response to the clarification request"
    },
    "clarification_response_datetime": {
      "type": "string",
      "description": "Date and time the doctor responded to the clarification request (ISO datetime)"
    },
    "accepted_datetime": {
      "type": "string",
      "description": "Date and time the department accepted the request (ISO datetime)"
    },
    "scheduled_datetime": {
      "type": "string",
      "description": "Date and time the imaging was scheduled (ISO datetime)"
    },
    "in_progress_datetime": {
      "type": "string",
      "description": "Date and time the examination was started (ISO datetime)"
    },
    "performed_datetime": {
      "type": "string",
      "description": "Date and time the imaging was performed / examination completed (ISO datetime)"
    },
    "images_received_datetime": {
      "type": "string",
      "description": "Date and time the images were recorded as received (ISO datetime)"
    },
    "ready_datetime": {
      "type": "string",
      "description": "Date and time the study was marked ready for reporting (ISO datetime)"
    },
    "reporting_datetime": {
      "type": "string",
      "description": "Date and time reporting started (ISO datetime)"
    },
    "image_file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image files / received studies associated with this request \u2014 uploaded by the department staff (PDF or image files in-app; external DICOM/PACS transfer is not part of the in-app flow)"
    },
    "image_notes": {
      "type": "string",
      "description": "Department notes about the received images (e.g. source system, series count)"
    },
    "updated_datetime": {
      "type": "string",
      "description": "Date and time of the last status update (ISO datetime)"
    },
    "final_report_datetime": {
      "type": "string",
      "description": "Date and time the final radiology report was finalized (ISO datetime)"
    },
    "released_datetime": {
      "type": "string",
      "description": "Date and time the final report was released to the patient record (ISO datetime)"
    },
    "cancel_reason": {
      "type": "string",
      "description": "Documented reason the request was cancelled"
    },
    "cancelled_datetime": {
      "type": "string",
      "description": "Date and time the request was cancelled (ISO datetime)"
    },
    "cancelled_by_name": {
      "type": "string",
      "description": "Who cancelled the request"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Workflow action that fired"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "by_role": {
            "type": "string",
            "description": "department / radiologist / doctor"
          },
          "datetime": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "to",
          "datetime"
        ]
      },
      "description": "Full status history \u2014 every workflow transition with actor, timestamps and notes"
    },
    "preparation_notes": {
      "type": "string",
      "description": "Patient preparation notes \u2014 fasting, hydration, contrast preparation completed before the examination"
    },
    "is_critical": {
      "type": "boolean",
      "default": false,
      "description": "True when a critical finding was identified on this imaging request. The requesting doctor and the patient are notified, and the flag is recorded in the Audit Log."
    },
    "critical_notified_datetime": {
      "type": "string",
      "description": "Date and time the critical finding notification was sent (ISO datetime)"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "completed"
      ],
      "default": "requested",
      "description": "Requested: active imaging order. Completed: imaging performed / reported / released."
    },
    "report": {
      "type": "string"
    },
    "report_file_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "Generated PDF Imaging Request Form"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_completed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "scan_type",
    "examination",
    "clinical_indication",
    "working_diagnosis",
    "priority",
    "date_requested"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.authorized_radiologist_user_ids": "{{user.id}}"
        },
        {
          "data.routed_hospital_user_id": "{{user.id}}"
        },
        {
          "data.assigned_radiologist_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}