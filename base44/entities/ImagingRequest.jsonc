{
  "name": "ImagingRequest",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security. Set when the doctor creates the request."
    },
    "doctor_id": {
      "type": "string"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the requesting doctor account \u2014 set server-side when the request is created, used for Row Level Security so the doctor can see and manage the requests they sent"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_specialization": {
      "type": "string",
      "description": "Specialty of the requesting doctor"
    },
    "doctor_hospital": {
      "type": "string",
      "description": "Hospital / clinic of the requesting doctor"
    },
    "request_id": {
      "type": "string",
      "description": "Unique imaging request reference, e.g. IR-20260907-8F3K"
    },
    "scan_type": {
      "type": "string",
      "enum": [
        "X-Ray",
        "CT",
        "MRI",
        "Ultrasound",
        "Mammography",
        "Other"
      ],
      "description": "Type of imaging (modality)"
    },
    "examination": {
      "type": "string",
      "description": "Examination / view requested for the selected modality"
    },
    "body_part": {
      "type": "string",
      "description": "Legacy field \u2014 kept in sync with the examination"
    },
    "clinical_indication": {
      "type": "string",
      "description": "Why the imaging is being requested \u2014 relevant clinical information"
    },
    "working_diagnosis": {
      "type": "string",
      "description": "Working diagnosis / clinical question for the radiologist"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Routine",
        "Urgent",
        "Emergency"
      ],
      "default": "Routine",
      "description": "Priority of the request"
    },
    "contrast": {
      "type": "string",
      "enum": [
        "No contrast",
        "With contrast",
        "With and without contrast",
        "Not applicable"
      ],
      "description": "Contrast use for the examination"
    },
    "contrast_allergy": {
      "type": "string",
      "enum": [
        "No known allergy",
        "Known allergy",
        "Unknown"
      ],
      "description": "Contrast allergy status"
    },
    "previous_contrast_reaction": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Previous contrast reaction"
    },
    "mri_metal_implant": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 metal or metallic implant in the body"
    },
    "mri_pacemaker": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 pacemaker or implanted cardiac device"
    },
    "mri_other_device": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 other implanted medical device"
    },
    "mri_metallic_foreign_body": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "MRI safety \u2014 possible metallic foreign body, especially in the eye"
    },
    "mri_other_concern": {
      "type": "string",
      "description": "MRI safety \u2014 other concern (free text)"
    },
    "request_datetime": {
      "type": "string",
      "description": "Date and time the request was created (ISO datetime)"
    },
    "request_time": {
      "type": "string",
      "description": "Time the request was created (HH:MM)"
    },
    "encounter_id": {
      "type": "string",
      "description": "Encounter reference the imaging request belongs to in the longitudinal AMedix Patient Record, e.g. ENC-20260916-8F3K \u2014 set when the request is created from an encounter"
    },
    "authorized_radiologist_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids of radiologists the PATIENT authorized for THIS SPECIFIC request only. Added server-side when the patient accepts the radiologist's access request \u2014 this is the Row Level Security gate for radiologist reads. Never grants access to the rest of the patient's record."
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "requested",
        "scheduled",
        "performed",
        "interpretation",
        "final_report",
        "released"
      ],
      "default": "requested",
      "description": "Radiology workflow stage \u2014 Request \u2192 Scheduled \u2192 Performed \u2192 Interpretation \u2192 Final Report \u2192 Released. Every transition is timestamped and recorded in the Audit Log."
    },
    "scheduled_datetime": {
      "type": "string",
      "description": "Date and time the imaging was scheduled (ISO datetime)"
    },
    "performed_datetime": {
      "type": "string",
      "description": "Date and time the imaging was performed (ISO datetime)"
    },
    "interpretation_datetime": {
      "type": "string",
      "description": "Date and time interpretation started (ISO datetime)"
    },
    "final_report_datetime": {
      "type": "string",
      "description": "Date and time the final radiology report was finalized (ISO datetime)"
    },
    "released_datetime": {
      "type": "string",
      "description": "Date and time the final report was released to the patient record (ISO datetime)"
    },
    "preparation_notes": {
      "type": "string",
      "description": "Patient preparation notes \u2014 fasting, hydration, contrast preparation completed before the examination"
    },
    "is_critical": {
      "type": "boolean",
      "default": false,
      "description": "True when a critical finding was identified on this imaging request. The requesting doctor and the patient are notified, and the flag is recorded in the Audit Log."
    },
    "critical_notified_datetime": {
      "type": "string",
      "description": "Date and time the critical finding notification was sent (ISO datetime)"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "completed"
      ],
      "default": "requested",
      "description": "Requested: active imaging order. Completed: imaging performed / reported / released."
    },
    "report": {
      "type": "string"
    },
    "report_file_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "Generated PDF Imaging Request Form"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_completed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "scan_type",
    "examination",
    "clinical_indication",
    "working_diagnosis",
    "priority",
    "date_requested"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.authorized_radiologist_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}