{
  "name": "LaboratoryProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lab_name": {
      "type": "string",
      "description": "Company / Laboratory Name"
    },
    "lab_number": {
      "type": "string",
      "description": "A&M Lab Number / ID \u2014 unique system-generated laboratory identification number, e.g. AML-2026-8F3K"
    },
    "address": {
      "type": "string",
      "description": "Laboratory location / address"
    },
    "phone": {
      "type": "string",
      "description": "Laboratory phone number"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "Laboratory WhatsApp number"
    },
    "email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Laboratory profile picture / logo"
    }
  },
  "required": [
    "user_id",
    "lab_name",
    "lab_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}