{
  "name": "LaboratoryProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lab_name": {
      "type": "string",
      "description": "Name of the laboratory"
    },
    "lab_number": {
      "type": "string",
      "description": "Company / laboratory registration number"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "lab_name",
    "lab_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}