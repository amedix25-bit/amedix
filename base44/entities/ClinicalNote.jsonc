{
  "name": "ClinicalNote",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set server-side when the note is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "doctor_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "description": "Patient date of birth \u2014 automatically attached to every note from the unified AMedix Patient Record at save time; never entered manually"
    },
    "doctor_name": {
      "type": "string"
    },
    "specialty": {
      "type": "string",
      "description": "Specialty key of the note's template, e.g. cardiology, neurology \u2014 automatically detected from the doctor's verified specialty when the note was created; the doctor is never asked to select it again"
    },
    "document_type": {
      "type": "string",
      "description": "Specialty-specific note type key that was loaded, e.g. cardio_consultation \u2014 empty for general free-text notes"
    },
    "document_type_label": {
      "type": "string",
      "description": "Display name of the specialty-specific note type, e.g. Cardiology Consultation"
    },
    "data": {
      "type": "object",
      "description": "Structured specialty-specific field values keyed by field key \u2014 each value is { label, value } so the note carries its own field labels. The note structure changes dynamically with the doctor's verified specialty; empty for general free-text notes.",
      "additionalProperties": true
    },
    "icd11_coded_diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_key": {
            "type": "string",
            "description": "Note field the diagnosis was recorded in, e.g. icd11_diagnoses"
          },
          "code": {
            "type": "string",
            "description": "ICD-11 MMS code exactly as verified \u2014 empty when the diagnosis could not be mapped. A code is never generated, completed or substituted by the app"
          },
          "display": {
            "type": "string",
            "description": "Official ICD-11 display term, or the diagnosis as documented when unresolved"
          },
          "system": {
            "type": "string",
            "description": "Coding system of this entry \u2014 always ICD-11-MMS. Laboratory (LOINC), medication and procedure codes are never stored here"
          },
          "system_uri": {
            "type": "string",
            "description": "Canonical FHIR system URI for ICD-11 MMS, so the entry is usable as a CodeableConcept"
          },
          "release": {
            "type": "string",
            "description": "ICD-11 release the code was verified against, e.g. 2025-01"
          },
          "source": {
            "type": "string",
            "description": "Where the code was verified \u2014 the catalogue source or the WHO browser reference the clinician entered"
          },
          "verified_date": {
            "type": "string",
            "description": "Date the catalogue entry was verified against the WHO release (ISO date)"
          },
          "coding_note": {
            "type": "string",
            "description": "Applicable WHO coding instruction for the entry (e.g. a non-primary tabulation entry documented together with the diabetes type)"
          },
          "specificity": {
            "type": "string",
            "description": "Specificity of the selected code \u2014 block (stem), subcategory, or pending review when unresolved"
          },
          "role": {
            "type": "string",
            "description": "Diagnosis role \u2014 Primary or Secondary"
          },
          "status": {
            "type": "string",
            "description": "Diagnostic status documented by the clinician \u2014 a code alone never confirms a diagnosis"
          },
          "mapping_state": {
            "type": "string",
            "enum": [
              "verified",
              "review_required",
              "unresolved"
            ],
            "description": "Mapping integrity state \u2014 VERIFIED: code taken from the verified ICD-11 catalogue with its release recorded. REVIEW_REQUIRED: code entered by the clinician from the WHO browser and not yet checked against the catalogue. UNRESOLVED: the diagnosis could not be mapped, so no code is stored and coding review is required"
          },
          "basis": {
            "type": "string",
            "description": "Clinical basis documented by the clinician for the coded diagnosis"
          },
          "follow_up": {
            "type": "string",
            "description": "Outstanding workup or follow-up for this coded diagnosis"
          }
        }
      },
      "description": "Structured ICD-11 coded diagnoses recorded on this note \u2014 the machine-readable copy of the diagnosis field, carrying code, official display term, system URI, release, source, mapping state, role, status and clinical basis. Written server-side with the note; readable only under the note's own access rules"
    },
    "photo_file_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clinical photographs attached to the note (e.g. dermatology lesion photos) \u2014 private storage URIs, only viewable via backend-issued signed URLs after permission checks. Follows the same permission, access control and audit rules as other clinical information."
    },
    "encounter_id": {
      "type": "string",
      "description": "Encounter the note automatically belongs to \u2014 resolved server-side at save time: the doctor's active encounter for the patient, or a new encounter opened automatically. The note always stays connected to the unified Patient Record and its encounter."
    },
    "hospital": {
      "type": "string",
      "description": "Hospital / clinic of the encounter \u2014 automatically attached from the doctor's verified active hospital"
    },
    "department": {
      "type": "string",
      "description": "Department of the encounter \u2014 automatically attached (the doctor's practicing specialty)"
    },
    "note_reference": {
      "type": "string",
      "description": "Unique AMedix clinical note reference, e.g. CN-20260916-8F3K \u2014 generated automatically at save time"
    },
    "allergies": {
      "type": "string",
      "description": "Patient allergies snapshot \u2014 automatically attached from the unified AMedix Patient Record at note time"
    },
    "current_medications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Active medications snapshot (medication names only) \u2014 automatically attached from the unified AMedix Patient Record at note time"
    },
    "previous_history": {
      "type": "string",
      "description": "Relevant previous history snapshot \u2014 the patient's recorded known conditions, automatically attached from the unified AMedix Patient Record at note time"
    },
    "signed_by_name": {
      "type": "string",
      "description": "Doctor who electronically signed the note \u2014 saving the note applies the doctor's electronic signature automatically"
    },
    "signed_datetime": {
      "type": "string",
      "description": "Date and time the electronic signature was applied (ISO datetime)"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "encounter_datetime": {
      "type": "string",
      "description": "Date and time the doctor saw the patient (ISO datetime)"
    },
    "location": {
      "type": "string",
      "enum": [
        "ER",
        "Clinic",
        "Ward",
        "ICU",
        "Other"
      ],
      "description": "Location of the encounter"
    },
    "history": {
      "type": "string",
      "description": "History section of the clinical note"
    },
    "vital_signs": {
      "type": "string",
      "description": "Vital Signs section of the clinical note"
    },
    "physical_examination": {
      "type": "string",
      "description": "Physical Examination section of the clinical note"
    },
    "provisional_diagnoses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provisional diagnoses entered by the doctor for this encounter \u2014 one entry per diagnosis"
    },
    "diagnosis": {
      "type": "string",
      "description": "Provisional diagnoses joined into a single summary string"
    },
    "notes": {
      "type": "string"
    },
    "prescription": {
      "type": "string",
      "description": "Prescriptions \u2014 part of Management"
    },
    "interventions": {
      "type": "string",
      "description": "Interventions \u2014 part of Management"
    },
    "biopsy": {
      "type": "string",
      "description": "Biopsy, if required \u2014 part of Management"
    },
    "lab_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked consolidated LabRequest ids"
    },
    "imaging_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked ImagingRequest ids"
    },
    "recommendations": {
      "type": "string",
      "description": "Doctor's Recommendations \u2014 follow-up instructions, lifestyle advice, referrals"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "date",
    "diagnosis"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}