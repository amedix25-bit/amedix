{
  "name": "MedicalHistoryEntry",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the entry is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "patient_seen"
      ],
      "default": "patient_seen",
      "description": "Type of medical history entry"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the patient was seen"
    },
    "time": {
      "type": "string",
      "description": "Time the patient was seen"
    },
    "doctor_id": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor who saw the patient"
    },
    "location": {
      "type": "string",
      "description": "Location of the encounter (ER / Clinic / Ward / etc.)"
    },
    "appointment_reason": {
      "type": "string",
      "description": "Type / reason of the appointment"
    },
    "status": {
      "type": "string",
      "description": "Final appointment status, e.g. Completed / Patient Seen"
    }
  },
  "required": [
    "patient_id",
    "date",
    "doctor_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}