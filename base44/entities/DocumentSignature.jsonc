{
  "name": "DocumentSignature",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "laboratory_request",
        "imaging_request",
        "prescription"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "description": "Kind of clinical document the signature was applied to"
    },
    "document_id": {
      "type": "string",
      "description": "Id of the signed document (LabRequest / ImagingRequest / Prescription)"
    },
    "document_reference": {
      "type": "string",
      "description": "Human-readable reference of the signed document"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the signing doctor"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the authenticated signing session \u2014 set by the server, never accepted from the browser"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_license": {
      "type": "string"
    },
    "signature_record_id": {
      "type": "string",
      "description": "DoctorSignature record the signature was applied from \u2014 verified server-side to belong to the signing doctor"
    },
    "signature_version": {
      "type": "integer",
      "description": "Version of the doctor's professional signature used on this document"
    },
    "signature_source": {
      "type": "string",
      "enum": [
        "saved_profile",
        "drawn_now",
        "uploaded_now"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink"
      ]
    },
    "signature_reference": {
      "type": "string",
      "description": "Human-readable signature reference recorded in the audit trail, e.g. SIG-V2-8F3K"
    },
    "signed_datetime": {
      "type": "string",
      "description": "Exact date and time the signature was applied (ISO datetime), set by the server"
    }
  },
  "required": [
    "document_type",
    "document_id",
    "doctor_user_id",
    "signature_record_id",
    "signed_datetime"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}