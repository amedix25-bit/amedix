{
  "name": "PatientProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cin": {
      "type": "string",
      "description": "Clinical Identification Number - unique permanent patient identifier"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "middle_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "nationality": {
      "type": "string",
      "description": "Patient's nationality \u2014 editable by the patient in Demographics"
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patient's occupations, e.g. Student, Physician \u2014 the patient can save several, each displayed separately and editable or removable"
    },
    "phone": {
      "type": "string",
      "description": "Legacy primary phone \u2014 kept in sync with the first entry of phone_numbers"
    },
    "phone_numbers": {
      "type": "array",
      "description": "Patient's phone numbers, each saved separately with a clear label",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "Primary",
              "Secondary",
              "Work",
              "Other"
            ],
            "description": "Label of this phone number"
          },
          "number": {
            "type": "string",
            "description": "The phone number itself"
          }
        },
        "required": [
          "label",
          "number"
        ]
      }
    },
    "address": {
      "type": "string"
    },
    "blood_type": {
      "type": "string",
      "enum": [
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-",
        "O+",
        "O-",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "allergies": {
      "type": "string"
    },
    "identification_number": {
      "type": "string",
      "description": "National ID, passport, or other required identification number"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Legacy first emergency contact name \u2014 kept in sync with the first entry of emergency_contacts"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Legacy first emergency contact phone \u2014 kept in sync with the first entry of emergency_contacts"
    },
    "emergency_contact_relationship": {
      "type": "string",
      "description": "Legacy first emergency contact relationship \u2014 kept in sync with the first entry of emergency_contacts"
    },
    "emergency_contacts": {
      "type": "array",
      "description": "Patient's emergency contacts \u2014 each has their own name, relationship to the patient and phone number, and can be edited or removed individually",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone"
        ]
      }
    },
    "smoking_status": {
      "type": "string",
      "enum": [
        "never",
        "former",
        "current"
      ],
      "default": "never"
    },
    "alcohol_use": {
      "type": "string",
      "enum": [
        "none",
        "occasional",
        "regular",
        "former"
      ],
      "default": "none"
    },
    "substance_use": {
      "type": "string"
    },
    "pregnancy_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "not_pregnant",
        "pregnant"
      ],
      "default": "not_applicable"
    },
    "gestational_age": {
      "type": "string"
    },
    "estimated_due_date": {
      "type": "string",
      "format": "date"
    },
    "pregnancy_history": {
      "type": "string"
    },
    "medication_info_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the patient has completed their medication information. When true, the 'Update Your Medication Information' notification is not recreated. An administrator can reset this flag to show the notification again."
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en",
      "description": "Patient's preferred Patient Portal language. Chosen during patient registration or with the language switch button inside the Patient Portal. 'ar' shows the portal in Arabic with an RTL layout."
    }
  },
  "required": [
    "user_id",
    "cin",
    "full_name"
  ]
}