{
  "name": "PatientProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cin": {
      "type": "string",
      "description": "Clinical Identification Number - unique permanent patient identifier"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "middle_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "blood_type": {
      "type": "string",
      "enum": [
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-",
        "O+",
        "O-",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "allergies": {
      "type": "string"
    },
    "identification_number": {
      "type": "string",
      "description": "National ID, passport, or other required identification number"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "smoking_status": {
      "type": "string",
      "enum": [
        "never",
        "former",
        "current"
      ],
      "default": "never"
    },
    "alcohol_use": {
      "type": "string",
      "enum": [
        "none",
        "occasional",
        "regular",
        "former"
      ],
      "default": "none"
    },
    "substance_use": {
      "type": "string"
    },
    "pregnancy_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "not_pregnant",
        "pregnant"
      ],
      "default": "not_applicable"
    },
    "gestational_age": {
      "type": "string"
    },
    "estimated_due_date": {
      "type": "string",
      "format": "date"
    },
    "pregnancy_history": {
      "type": "string"
    },
    "medication_info_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the patient has completed their medication information. When true, the 'Update Your Medication Information' notification is not recreated. An administrator can reset this flag to show the notification again."
    }
  },
  "required": [
    "user_id",
    "cin",
    "full_name"
  ]
}