{
  "name": "PatientProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cin": {
      "type": "string",
      "description": "Clinical Identification Number - unique permanent patient identifier"
    },
    "photo_uri": {
      "type": "string",
      "description": "Private storage URI of the patient's own picture shown on their Medical ID card. Uploaded by the patient from the Patient Portal; never a public URL \u2014 the card displays it through a short-lived signed link."
    },
    "full_name": {
      "type": "string",
      "description": "Patient's full name in English \u2014 First, Father's, Grandfather's and Last Name joined. Used in clinical documents and wherever the English name is required."
    },
    "first_name": {
      "type": "string",
      "description": "Patient's first name in English \u2014 exactly as printed on the Passport or official English identification document"
    },
    "father_name": {
      "type": "string",
      "description": "Patient's father's name in English \u2014 exactly as printed on the Passport or official English identification document"
    },
    "grandfather_name": {
      "type": "string",
      "description": "Patient's grandfather's name in English \u2014 exactly as printed on the Passport or official English identification document"
    },
    "last_name": {
      "type": "string",
      "description": "Patient's last name in English \u2014 exactly as printed on the Passport or official English identification document"
    },
    "middle_name": {
      "type": "string",
      "description": "Legacy field \u2014 kept in sync with father_name for older views; new registration uses father_name"
    },
    "full_name_ar": {
      "type": "string",
      "description": "Patient's full name in Arabic \u2014 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644\u060c \u0627\u0633\u0645 \u0627\u0644\u0623\u0628\u060c \u0627\u0633\u0645 \u0627\u0644\u062c\u062f\u060c \u0627\u0644\u0644\u0642\u0628 joined, exactly as printed on the official Arabic document. Displayed when the patient uses the Arabic Patient Portal; stored in the same profile as the English name."
    },
    "first_name_ar": {
      "type": "string",
      "description": "Patient's first name in Arabic \u2014 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644, exactly as printed on the official Arabic document"
    },
    "father_name_ar": {
      "type": "string",
      "description": "Patient's father's name in Arabic \u2014 \u0627\u0633\u0645 \u0627\u0644\u0623\u0628, exactly as printed on the official Arabic document"
    },
    "grandfather_name_ar": {
      "type": "string",
      "description": "Patient's grandfather's name in Arabic \u2014 \u0627\u0633\u0645 \u0627\u0644\u062c\u062f, exactly as printed on the official Arabic document"
    },
    "last_name_ar": {
      "type": "string",
      "description": "Patient's last name in Arabic \u2014 \u0627\u0644\u0644\u0642\u0628, exactly as printed on the official Arabic document"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "nationality": {
      "type": "string",
      "description": "Patient's nationality \u2014 editable by the patient in Demographics"
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patient's occupations, e.g. Student, Physician \u2014 the patient can save several, each displayed separately and editable or removable"
    },
    "phone": {
      "type": "string",
      "description": "Legacy primary phone \u2014 kept in sync with the first entry of phone_numbers"
    },
    "phone_numbers": {
      "type": "array",
      "description": "Patient's phone numbers, each saved separately with a clear label",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "Primary",
              "Secondary",
              "Work",
              "Other"
            ],
            "description": "Label of this phone number"
          },
          "number": {
            "type": "string",
            "description": "The phone number itself"
          }
        },
        "required": [
          "label",
          "number"
        ]
      }
    },
    "address": {
      "type": "string"
    },
    "blood_type": {
      "type": "string",
      "enum": [
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-",
        "O+",
        "O-",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "allergies": {
      "type": "string"
    },
    "identification_number": {
      "type": "string",
      "description": "National ID, passport, or other required identification number"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Legacy first emergency contact name \u2014 kept in sync with the first entry of emergency_contacts"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Legacy first emergency contact phone \u2014 kept in sync with the first entry of emergency_contacts"
    },
    "emergency_contact_relationship": {
      "type": "string",
      "description": "Legacy first emergency contact relationship \u2014 kept in sync with the first entry of emergency_contacts"
    },
    "emergency_contacts": {
      "type": "array",
      "description": "Patient's emergency contacts \u2014 each has their own name, relationship to the patient and phone number, and can be edited or removed individually",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone"
        ]
      }
    },
    "smoking_status": {
      "type": "string",
      "enum": [
        "never",
        "former",
        "current"
      ],
      "default": "never"
    },
    "tobacco_details": {
      "type": "string",
      "description": "Tobacco type and quantity, if applicable \u2014 e.g. 'Cigarettes, 10/day'"
    },
    "vaping_history": {
      "type": "string",
      "description": "Vaping history, voluntarily disclosed"
    },
    "alcohol_use": {
      "type": "string",
      "enum": [
        "none",
        "occasional",
        "regular",
        "former"
      ],
      "default": "none"
    },
    "substance_use": {
      "type": "string",
      "description": "Recreational substance use \u2014 voluntarily disclosed, optional"
    },
    "occupation": {
      "type": "string",
      "description": "Patient's occupation as entered during registration"
    },
    "occupational_exposure": {
      "type": "string",
      "description": "Relevant occupational exposures, e.g. dust, chemicals \u2014 optional"
    },
    "physical_activity": {
      "type": "string",
      "enum": [
        "sedentary",
        "light",
        "moderate",
        "active"
      ],
      "description": "Patient's physical activity level"
    },
    "typical_diet": {
      "type": "string",
      "description": "Diet details / the specification of an 'other' diet type, where clinically useful \u2014 optional free text. The structured diet types are stored in diet_types."
    },
    "diet_types": {
      "type": "array",
      "description": "Diet types the patient reports following \u2014 several may apply. Optional and patient-reported; 'other' pairs with the typical_diet details field.",
      "items": {
        "type": "string",
        "enum": [
          "balanced",
          "vegetarian",
          "vegan",
          "mediterranean",
          "low_carb",
          "high_protein",
          "low_salt",
          "diabetic",
          "renal",
          "gluten_free",
          "lactose_free",
          "other"
        ]
      }
    },
    "food_allergies_intolerances": {
      "type": "string",
      "description": "Food allergies, intolerances and dietary restrictions reported by the patient \u2014 optional free text. Self-reported and never treated as clinically verified; allergy entries stay in the Allergy records."
    },
    "sleep_patterns": {
      "type": "array",
      "description": "Sleep patterns the patient reports \u2014 several may apply. Optional; 'other' pairs with sleep_pattern_other and further detail with sleep_concerns.",
      "items": {
        "type": "string",
        "enum": [
          "sleeps_through_night",
          "frequent_waking",
          "difficulty_falling_asleep",
          "early_waking",
          "restless_sleep",
          "excessive_sleep",
          "other"
        ]
      }
    },
    "sleep_pattern_other": {
      "type": "string",
      "description": "The patient's specification of an 'other' sleep pattern \u2014 optional"
    },
    "sleep_concerns": {
      "type": "string",
      "description": "Any additional sleep-related concerns reported by the patient \u2014 optional"
    },
    "mobility_limitations": {
      "type": "string",
      "description": "Mobility and functional limitations, if any \u2014 optional"
    },
    "living_situation_type": {
      "type": "string",
      "enum": [
        "alone",
        "immediate_family",
        "extended_family",
        "caregiver",
        "assisted_living",
        "other"
      ],
      "description": "Primary living situation \u2014 one answer only. Optional; additional detail (including the specification of 'other') is stored in living_situation."
    },
    "living_situation": {
      "type": "string",
      "description": "Additional living-situation details or caregiving needs, including the specification of an 'other' living situation \u2014 optional"
    },
    "consanguinity": {
      "type": "string",
      "enum": [
        "none",
        "known",
        "prefer_not_to_answer"
      ],
      "description": "Known consanguinity \u2014 voluntarily disclosed; the patient may decline to answer"
    },
    "vaccination_status": {
      "type": "string",
      "enum": [
        "fully_vaccinated",
        "partially_vaccinated",
        "not_vaccinated",
        "unknown"
      ],
      "description": "Vaccination status reported by the patient, one answer only. Optional and self-reported: an unanswered or unknown status is never treated as unvaccinated."
    },
    "vaccination_records": {
      "type": "array",
      "description": "Individual vaccines the patient reported \u2014 whether received, the date, doses and notes where known. Only answered vaccines are stored: a vaccine the patient did not answer is not recorded at all, never as not received.",
      "items": {
        "type": "object",
        "properties": {
          "vaccine": {
            "type": "string",
            "enum": [
              "hepatitis_b",
              "hepatitis_a",
              "bcg",
              "polio",
              "dtp",
              "hib",
              "pneumococcal",
              "mmr",
              "varicella",
              "hpv",
              "meningococcal",
              "influenza",
              "covid19",
              "other"
            ]
          },
          "other_label": {
            "type": "string",
            "description": "Name of the vaccine when 'other' was selected"
          },
          "received": {
            "type": "string",
            "enum": [
              "received",
              "not_received",
              "unknown"
            ],
            "description": "RECEIVED: the patient reports having had the vaccine. NOT_RECEIVED: the patient reports not having had it. UNKNOWN: the patient is unsure."
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "doses": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "vaccine",
          "received"
        ]
      }
    },
    "allergy_record_status": {
      "type": "string",
      "enum": [
        "no_known_allergies",
        "not_established"
      ],
      "description": "Section-level allergy state set at registration \u2014 NO_KNOWN_ALLERGIES: the patient reports no known allergies. NOT_ESTABLISHED: the patient is unsure / allergies not yet established. Empty when allergy entries exist. A patient's answer is never treated as clinically verified"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "married",
        "not_married"
      ],
      "description": "Marital status \u2014 collected at registration for female patients"
    },
    "pregnancy_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "not_pregnant",
        "pregnant",
        "unknown"
      ],
      "default": "not_applicable",
      "description": "Pregnancy status of a married female patient \u2014 answered at registration, including Unknown when the patient is unsure"
    },
    "gestational_age": {
      "type": "string"
    },
    "estimated_due_date": {
      "type": "string",
      "format": "date"
    },
    "gravida": {
      "type": "integer",
      "description": "Number of pregnancies (Gravida) \u2014 collected at registration for married female patients"
    },
    "para": {
      "type": "integer",
      "description": "Number of births (Para) \u2014 collected at registration for married female patients"
    },
    "living_children": {
      "type": "integer",
      "description": "Number of living children \u2014 collected at registration for married female patients"
    },
    "miscarriages_abortions": {
      "type": "integer",
      "description": "Number of miscarriages/abortions \u2014 collected at registration for married female patients"
    },
    "stillbirths": {
      "type": "integer",
      "description": "Number of stillbirths \u2014 collected at registration for married female patients"
    },
    "pregnancy_history": {
      "type": "string"
    },
    "pregnancy_complications": {
      "type": "string",
      "description": "Significant pregnancy complications, if any \u2014 access-controlled reproductive history"
    },
    "menstrual_history": {
      "type": "string",
      "description": "Menstrual history, when relevant \u2014 access-controlled reproductive history"
    },
    "contraception_history": {
      "type": "string",
      "description": "Relevant contraception history \u2014 access-controlled reproductive history"
    },
    "fertility_history": {
      "type": "string",
      "description": "Fertility-related history, if relevant \u2014 access-controlled reproductive history"
    },
    "gynecological_history": {
      "type": "string",
      "description": "Relevant gynecological history \u2014 access-controlled reproductive history"
    },
    "urological_history": {
      "type": "string",
      "description": "Relevant urological or reproductive history \u2014 access-controlled reproductive history"
    },
    "medication_info_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the patient has completed their medication information. When true, the 'Update Your Medication Information' notification is not recreated. An administrator can reset this flag to show the notification again."
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en",
      "description": "Patient's preferred Patient Portal language. Chosen during patient registration or with the language switch button inside the Patient Portal. 'ar' shows the portal in Arabic with an RTL layout."
    }
  },
  "required": [
    "user_id",
    "cin",
    "full_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}