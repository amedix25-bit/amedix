{
  "name": "SignupOtp",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "email"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "description": "Which channel the code was delivered on. SMS: a Libyan mobile number verified through Resala. EMAIL: a verification code sent by email."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "signup",
        "recovery"
      ],
      "enumColors": [
        "blue",
        "yellow"
      ],
      "default": "signup",
      "description": "What the code is for. SIGNUP: confirming a destination before creating an account. RECOVERY: proving ownership of an existing account before continuing a saved registration. A recovery code lives longer than a signup code."
    },
    "destination": {
      "type": "string",
      "description": "Where the code was sent: the normalised phone number (2189XXXXXXXX) or the normalised email address"
    },
    "challenge_token": {
      "type": "string",
      "description": "Random reference given to the browser so it can verify the code without ever learning the code or the record id. A resend keeps the SAME token, so the screen the user already has keeps working."
    },
    "code_hash": {
      "type": "string",
      "description": "Salted SHA-256 hash of the 6-digit code. The code itself is never stored, logged or returned"
    },
    "code_salt": {
      "type": "string",
      "description": "Random per-challenge salt used with the code hash"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "locked",
        "expired"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "pending",
      "description": "PENDING: a code is outstanding. VERIFIED: the destination was successfully verified. LOCKED: too many wrong attempts, a new code must be requested. EXPIRED: the code passed its expiry or was superseded by a newer one."
    },
    "attempts": {
      "type": "integer",
      "default": 0,
      "description": "Wrong code attempts made against this challenge"
    },
    "max_attempts": {
      "type": "integer",
      "default": 5,
      "description": "Wrong attempts allowed before the challenge locks"
    },
    "send_count": {
      "type": "integer",
      "default": 1,
      "description": "How many times a code has been dispatched for this challenge. Used to measure resend behaviour and to bound repeated sends."
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "description": "Whether the provider accepted the message. FAILED challenges are never left looking like a code the user should be waiting for."
    },
    "delivery_error": {
      "type": "string",
      "description": "Machine-readable reason the last dispatch failed, e.g. provider_rejected, unsubscribed, bounced. Never contains the code."
    },
    "expires_datetime": {
      "type": "string",
      "description": "Date and time the code stops being valid (ISO datetime)"
    },
    "cooldown_until": {
      "type": "string",
      "description": "Another code for this destination cannot be requested before this time (ISO datetime)"
    },
    "sent_datetime": {
      "type": "string",
      "description": "Date and time the code was first sent (ISO datetime)"
    },
    "last_sent_datetime": {
      "type": "string",
      "description": "Date and time the most recent code for this challenge was dispatched (ISO datetime)"
    },
    "verified_datetime": {
      "type": "string",
      "description": "Date and time the destination was verified (ISO datetime)"
    },
    "provider_pin_id": {
      "type": "string",
      "description": "Resala message id for an SMS code, recorded for support and delivery tracing"
    }
  },
  "required": [
    "channel",
    "destination",
    "challenge_token",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}