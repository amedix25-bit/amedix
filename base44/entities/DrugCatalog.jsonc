{
  "name": "DrugCatalog",
  "type": "object",
  "properties": {
    "medication_name": {
      "type": "string",
      "description": "Brand / product name of the drug, e.g. Panadol"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Active ingredient (generic name), e.g. Paracetamol"
    },
    "common_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common strengths the drug is marketed in, e.g. 500 mg"
    },
    "dosage_form": {
      "type": "string",
      "description": "Typical dosage form, e.g. tablet, syrup, injection, cream, drops"
    }
  },
  "required": [
    "medication_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}