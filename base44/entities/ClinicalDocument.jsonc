{
  "name": "ClinicalDocument",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique AMedix Document ID, e.g. AMD-20260916-8F3K. Shared by all versions of the same document (amendments keep the same document_id and increment version)."
    },
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the document belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "description": "Patient date of birth \u2014 automatically attached to every completed document"
    },
    "encounter_id": {
      "type": "string",
      "description": "Encounter this document is permanently associated with"
    },
    "hospital": {
      "type": "string",
      "description": "Hospital / clinic of the encounter"
    },
    "department": {
      "type": "string",
      "description": "Department of the encounter"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the authoring doctor"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the doctor account \u2014 used for Row Level Security"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor name \u2014 automatically attached to every completed document"
    },
    "doctor_specialty": {
      "type": "string",
      "description": "Doctor specialty \u2014 automatically attached to every completed document"
    },
    "specialty": {
      "type": "string",
      "description": "Specialty key this document type belongs to, e.g. internal_medicine, surgery, emergency_medicine, pediatrics, obstetrics_gynecology, anesthesiology \u2014 empty for general documents available to all doctors. Derived server-side from the document type."
    },
    "document_type": {
      "type": "string",
      "description": "Type of clinical document \u2014 a general type key (e.g. progress_note, discharge_summary) or a specialty-specific type key (e.g. surg_operative_note, em_triage, obgyn_initial_antenatal, peds_well_child, anes_intraop_record). Validated server-side against the clinical document catalog."
    },
    "document_type_label": {
      "type": "string",
      "description": "Display name of the document type"
    },
    "content": {
      "type": "string",
      "description": "Clinical narrative content of this document version"
    },
    "data": {
      "type": "object",
      "description": "Structured specialty field values keyed by field key \u2014 each value is { label, value } so every completed document carries its own field labels for display and PDF. Empty for general free-text documents.",
      "additionalProperties": true
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Version number \u2014 originals are version 1; an amendment creates a new version. Signed versions are never overwritten."
    },
    "previous_version_id": {
      "type": "string",
      "description": "Id of the version this amendment corrects \u2014 empty for originals"
    },
    "is_amendment": {
      "type": "boolean",
      "default": false,
      "description": "True when this version is an amendment of a previously signed version"
    },
    "amendment_reason": {
      "type": "string",
      "description": "Reason for the amendment, entered by the doctor"
    },
    "amendment_status": {
      "type": "string",
      "enum": [
        "original",
        "amendment"
      ],
      "default": "original",
      "description": "Whether this version is the original document or an amendment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "signed"
      ],
      "default": "draft",
      "description": "DRAFT: editable/not yet finalized. SIGNED: digitally signed \u2014 immutable; corrections require a new version."
    },
    "signed_by_name": {
      "type": "string",
      "description": "Doctor who electronically signed this version"
    },
    "signed_datetime": {
      "type": "string",
      "description": "Date and time the document was electronically signed (ISO datetime)"
    },
    "pdf_url": {
      "type": "string",
      "description": "PDF version of the completed, signed document \u2014 stored in the patient's Clinical Notes/Documents"
    },
    "created_datetime": {
      "type": "string",
      "description": "Date and time this version was created (ISO datetime) \u2014 automatically recorded"
    },
    "created_by_name": {
      "type": "string",
      "description": "Doctor who created this version \u2014 automatically recorded"
    }
  },
  "required": [
    "document_id",
    "patient_id",
    "doctor_id",
    "document_type",
    "version",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}