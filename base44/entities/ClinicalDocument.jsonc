{
  "name": "ClinicalDocument",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique AMedix Document ID, e.g. AMD-20260916-8F3K. Shared by all versions of the same document (amendments keep the same document_id and increment version)."
    },
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the document belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "description": "Patient date of birth \u2014 automatically attached to every completed document"
    },
    "encounter_id": {
      "type": "string",
      "description": "Encounter this document is permanently associated with"
    },
    "hospital": {
      "type": "string",
      "description": "Hospital / clinic of the encounter"
    },
    "department": {
      "type": "string",
      "description": "Department of the encounter"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the authoring doctor"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the doctor account \u2014 used for Row Level Security"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor name \u2014 automatically attached to every completed document"
    },
    "doctor_specialty": {
      "type": "string",
      "description": "Doctor specialty \u2014 automatically attached to every completed document"
    },
    "specialty": {
      "type": "string",
      "description": "Specialty key this document type belongs to, e.g. cardiology, neurology, psychiatry, ophthalmology, dermatology, orthopedics, urology, ent, pulmonology, gastroenterology, nephrology, endocrinology \u2014 empty for general documents. Derived server-side from the document type."
    },
    "document_type": {
      "type": "string",
      "description": "Type of clinical document \u2014 a general type key (e.g. progress_note, discharge_summary) or a specialty-specific type key (e.g. cardio_ecg_report, neuro_stroke_record, psy_risk_assessment, derm_lesion_assessment, neph_dialysis_record). Validated server-side against the clinical document catalog."
    },
    "document_type_label": {
      "type": "string",
      "description": "Display name of the document type"
    },
    "content": {
      "type": "string",
      "description": "Clinical narrative content of this document version"
    },
    "data": {
      "type": "object",
      "description": "Structured specialty field values keyed by field key \u2014 each value is { label, value } so every completed document carries its own field labels for display and PDF. Empty for general free-text documents.",
      "additionalProperties": true
    },
    "is_confidential": {
      "type": "boolean",
      "default": false,
      "description": "True for restricted/confidential documents (e.g. psychiatric records). Confidential documents are only accessible to the authoring doctor, the patient and administrators \u2014 Row Level Security and the clinical record endpoint exclude them from every other doctor's view."
    },
    "photo_file_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clinical photographs attached to the document (e.g. dermatology lesion photos) \u2014 private storage URIs, only viewable via backend-issued signed URLs after permission checks. Follows the same permission, access control and audit rules as other clinical information."
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Version number \u2014 originals are version 1; an amendment creates a new version. Signed versions are never overwritten."
    },
    "previous_version_id": {
      "type": "string",
      "description": "Id of the version this amendment corrects \u2014 empty for originals"
    },
    "is_amendment": {
      "type": "boolean",
      "default": false,
      "description": "True when this version is an amendment of a previously signed version"
    },
    "amendment_reason": {
      "type": "string",
      "description": "Reason for the amendment, entered by the doctor"
    },
    "amendment_status": {
      "type": "string",
      "enum": [
        "original",
        "amendment"
      ],
      "default": "original",
      "description": "Whether this version is the original document or an amendment"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "signed"
      ],
      "default": "draft",
      "description": "DRAFT: editable/not yet finalized. SIGNED: digitally signed \u2014 immutable; corrections require a new version."
    },
    "signed_by_name": {
      "type": "string",
      "description": "Doctor who electronically signed this version"
    },
    "signed_datetime": {
      "type": "string",
      "description": "Date and time the document was electronically signed (ISO datetime)"
    },
    "pdf_url": {
      "type": "string",
      "description": "PDF version of the completed, signed document \u2014 stored in the patient's Clinical Notes/Documents"
    },
    "created_datetime": {
      "type": "string",
      "description": "Date and time this version was created (ISO datetime) \u2014 automatically recorded"
    },
    "created_by_name": {
      "type": "string",
      "description": "Doctor who created this version \u2014 automatically recorded"
    }
  },
  "required": [
    "document_id",
    "patient_id",
    "doctor_id",
    "document_type",
    "version",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}