{
  "name": "ReferralLetter",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the referral belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string"
    },
    "patient_age": {
      "type": "string"
    },
    "patient_sex": {
      "type": "string"
    },
    "patient_contact": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the referring doctor"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the referring doctor account \u2014 used for Row Level Security"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_specialization": {
      "type": "string"
    },
    "doctor_hospital": {
      "type": "string"
    },
    "doctor_contact": {
      "type": "string"
    },
    "doctor_license": {
      "type": "string"
    },
    "referral_number": {
      "type": "string",
      "description": "Unique referral reference, e.g. RF-20260911-8F3K"
    },
    "verification_code": {
      "type": "string",
      "description": "Verification code printed on the PDF \u2014 together with the QR code it proves the referral is authentic"
    },
    "referral_date": {
      "type": "string",
      "format": "date"
    },
    "referral_datetime": {
      "type": "string",
      "description": "Date and time the referral was generated (ISO datetime)"
    },
    "receiving_doctor": {
      "type": "string",
      "description": "Receiving doctor or department the patient is referred to"
    },
    "receiving_specialty": {
      "type": "string",
      "description": "Specialty or department of the receiving doctor"
    },
    "receiving_doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the receiving doctor when selected from My Colleagues"
    },
    "receiving_doctor_user_id": {
      "type": "string",
      "description": "User id of the receiving doctor account \u2014 used for Row Level Security so the receiving doctor can view and manage referrals sent to them"
    },
    "receiving_hospital": {
      "type": "string",
      "description": "Hospital / clinic of the receiving doctor \u2014 from their verified profile"
    },
    "receiving_contact": {
      "type": "string",
      "description": "Professional contact information of the receiving doctor"
    },
    "reason_for_referral": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "Routine",
        "Urgent",
        "Emergency"
      ],
      "default": "Routine"
    },
    "working_diagnosis": {
      "type": "string",
      "description": "Primary / working diagnosis at the time of referral"
    },
    "symptoms_duration": {
      "type": "string",
      "description": "Relevant symptoms and their duration"
    },
    "past_medical_history": {
      "type": "string"
    },
    "past_surgical_history": {
      "type": "string"
    },
    "current_medications": {
      "type": "string"
    },
    "allergies": {
      "type": "string"
    },
    "physical_examination": {
      "type": "string"
    },
    "vital_signs": {
      "type": "string"
    },
    "lab_results": {
      "type": "string",
      "description": "Relevant laboratory results"
    },
    "imaging_results": {
      "type": "string"
    },
    "pathology_results": {
      "type": "string",
      "description": "Pathology / biopsy results"
    },
    "other_investigations": {
      "type": "string"
    },
    "treatment_medications": {
      "type": "string",
      "description": "Medications already given"
    },
    "treatment_procedures": {
      "type": "string"
    },
    "previous_treatments": {
      "type": "string"
    },
    "treatment_response": {
      "type": "string",
      "description": "The patient's response to treatment"
    },
    "specific_request": {
      "type": "string",
      "description": "What the referring doctor asks of the receiving doctor \u2014 evaluation, investigation, specialist opinion or management"
    },
    "attachments": {
      "type": "array",
      "description": "Documents from the patient's Documents section attached to this referral",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "file_url"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "completed"
      ],
      "default": "draft",
      "description": "DRAFT: generated by the doctor. SENT: sent to the receiving doctor. VIEWED: opened by the patient. COMPLETED: the referral episode is finished."
    },
    "pdf_url": {
      "type": "string"
    },
    "audit_trail": {
      "type": "array",
      "description": "Who created, sent, viewed or updated the referral and when",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "created / sent / viewed / completed / updated"
          },
          "by_name": {
            "type": "string"
          },
          "by_role": {
            "type": "string",
            "description": "doctor / patient / admin"
          },
          "datetime": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "datetime"
        ]
      }
    }
  },
  "required": [
    "patient_id",
    "patient_user_id",
    "doctor_id",
    "doctor_user_id",
    "referral_number",
    "referral_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "data.receiving_doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.doctor_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "data.receiving_doctor_user_id": "{{user.id}}"
        },
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}