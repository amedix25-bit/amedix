{
  "name": "PatientNotification",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the notification is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "type": {
      "type": "string",
      "enum": [
        "appointment",
        "rescheduled",
        "lab_request",
        "lab_results",
        "medication_update",
        "medication_reminder",
        "recall",
        "other"
      ],
      "default": "other",
      "description": "Category of the notification. MEDICATION_REMINDER: an optional adherence reminder for a scheduled dose."
    },
    "title": {
      "type": "string",
      "description": "Short notification heading"
    },
    "message": {
      "type": "string",
      "description": "Minimal, non-sensitive summary shown to the patient"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Read state of the notification"
    },
    "target": {
      "type": "string",
      "description": "Patient Portal tab the notification opens (appointments / labs / mylabresults / medications / prescriptions / reminders)"
    },
    "related_id": {
      "type": "string",
      "description": "Related appointment / lab request id"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the related event (used to avoid duplicate appointment reminders)"
    }
  },
  "required": [
    "patient_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}