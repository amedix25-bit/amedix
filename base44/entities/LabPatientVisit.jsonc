{
  "name": "LabPatientVisit",
  "type": "object",
  "properties": {
    "laboratory_id": {
      "type": "string"
    },
    "lab_user_id": {
      "type": "string",
      "description": "User id of the laboratory owner account \u2014 set server-side, used for access control"
    },
    "lab_name": {
      "type": "string"
    },
    "technician_id": {
      "type": "string"
    },
    "technician_name": {
      "type": "string"
    },
    "lab_request_id": {
      "type": "string",
      "description": "Original LabRequest this visit belongs to"
    },
    "request_ref": {
      "type": "string",
      "description": "Lab request reference, e.g. LR-20260907-8F3K"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "requested_tests": {
      "type": "string",
      "description": "Comma-separated names of the requested tests"
    },
    "identification_method": {
      "type": "string",
      "enum": [
        "cin",
        "qr"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "testing_pending",
        "tests_completed",
        "results_uploaded",
        "patient_notified"
      ],
      "default": "testing_pending",
      "description": "Workflow status of the visit"
    },
    "result_file_url": {
      "type": "string"
    },
    "result_file_name": {
      "type": "string"
    },
    "results_uploaded_at": {
      "type": "string",
      "description": "ISO datetime when the results report was uploaded"
    },
    "results_ready_at": {
      "type": "string",
      "description": "ISO datetime when results were marked ready"
    }
  },
  "required": [
    "laboratory_id",
    "lab_user_id",
    "technician_id",
    "lab_request_id",
    "patient_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.lab_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.lab_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.lab_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}