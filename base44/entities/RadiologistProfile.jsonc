{
  "name": "RadiologistProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "Radiologist's first name"
    },
    "middle_name": {
      "type": "string",
      "description": "Radiologist's middle name"
    },
    "last_name": {
      "type": "string",
      "description": "Radiologist's last name"
    },
    "name_edited": {
      "type": "boolean",
      "default": false,
      "description": "True once the radiologist has set or confirmed their first/middle/last name in the portal"
    },
    "photo_url": {
      "type": "string",
      "description": "Radiologist profile picture \u2014 uploaded by the radiologist, shown wherever the radiologist appears to other users"
    },
    "specialization": {
      "type": "string",
      "description": "Radiology specialty, e.g. Diagnostic Radiology, Interventional Radiology, Neuroradiology"
    },
    "hospital": {
      "type": "string",
      "description": "Legacy home facility (hospital / imaging center) the radiologist registered with \u2014 kept for backward compatibility. Additional facility memberships are granted by facility administrators in authorized_facilities."
    },
    "authorized_facilities": {
      "type": "array",
      "description": "Facility radiology departments this radiologist is authorized for \u2014 granted by each facility's administrator (never self-declared). A radiologist working at multiple facilities has one entry per facility and can switch between them. The legacy home facility above remains valid on its own.",
      "items": {
        "type": "object",
        "properties": {
          "hospital_user_id": {
            "type": "string",
            "description": "User id of the facility's administrator (HospitalProfile.user_id) \u2014 links the membership to the facility ID, never just a name"
          },
          "hospital_name": {
            "type": "string",
            "description": "Facility name at the time the membership was granted"
          },
          "added_datetime": {
            "type": "string",
            "description": "Date and time the administrator granted the membership (ISO datetime)"
          },
          "added_by_name": {
            "type": "string",
            "description": "Administrator who granted the membership"
          }
        },
        "required": [
          "hospital_user_id",
          "hospital_name"
        ]
      }
    },
    "license_number": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Radiologist account status"
    },
    "doctor_portal_access": {
      "type": "boolean",
      "default": false,
      "description": "Administrator-controlled permission. When true, the radiologist may also use the regular Doctor Portal; otherwise the account is limited to the Radiologist Portal."
    }
  },
  "required": [
    "user_id",
    "full_name",
    "specialization"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}