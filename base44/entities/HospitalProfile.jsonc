{
  "name": "HospitalProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "hospital_name": {
      "type": "string",
      "description": "Hospital / medical center name"
    },
    "location": {
      "type": "string",
      "description": "Hospital location / address"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Hospital profile photo"
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Payment methods accepted by the hospital for patient visits, e.g. Cash, Card, Bank Transfer \u2014 configurable by the hospital"
    },
    "hospital_code": {
      "type": "string",
      "description": "Unique AMedix Hospital Code \u2014 generated by the backend with cryptographic randomness and checked for uniqueness across all hospitals. Doctors can only join the hospital with this code, never by typing the hospital name. Shown to the hospital administrator only."
    },
    "radiology_department_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this facility has a configured RADIOLOGY DEPARTMENT that receives imaging requests. When true, the administrator can open the Radiology Department Portal and doctors' imaging requests for this facility route to its worklist. When false, imaging requests for this facility are rejected with a clear routing error."
    },
    "pacs_integration_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the facility's EXISTING imaging system (PACS / RIS / web viewer / RadiAnt) is connected to AMedix. Configured by the hospital administrator after confirming the vendor's supported integration method \u2014 never assumed. When false, radiologists see images stored in AMedix only."
    },
    "pacs_integration_type": {
      "type": "string",
      "enum": [
        "radiant",
        "dicomweb",
        "web_viewer",
        "desktop_app",
        "ohif_embedded",
        "none"
      ],
      "default": "none",
      "description": "How the facility's existing imaging software integrates: radiant \u2014 the RadiAnt DICOM Viewer installed on radiologists' Windows workstations is opened with a radiant:// launch URL and retrieves the study from the facility PACS directly (no images are stored in AMedix); dicomweb \u2014 DICOMweb (QIDO/WADO) endpoint verified against the vendor; web_viewer \u2014 browser viewer opened through a launch URL template; desktop_app \u2014 desktop software that cannot be embedded (studies are opened manually by reference); ohif_embedded \u2014 the facility's OWN approved OHIF Viewer deployment embedded in the Imaging Viewer tab. Set only after the vendor confirms support."
    },
    "pacs_vendor_name": {
      "type": "string",
      "description": "Vendor / product name of the facility's imaging system, recorded by the administrator for the integration record"
    },
    "pacs_viewer_url_template": {
      "type": "string",
      "description": "Vendor-documented viewer launch URL template with placeholders {study_instance_uid}, {accession_number}, {request_id}, {launch_token}. Substituted server-side only \u2014 the template and any vendor credentials never reach the browser. Patient identifiers (names, CINs) are never permitted in viewer URLs."
    },
    "pacs_radiant_launch_template": {
      "type": "string",
      "description": "RadiAnt DICOM Viewer launch URL using the radiant:// custom URL protocol, e.g. radiant://?n=pstv&v=0020000D&v=%22{study_instance_uid}%22 or the accession variant radiant://?n=pstv&v=00080050&v=%22{accession_number}%22. Only {study_instance_uid} and {accession_number} placeholders are permitted, and the exact syntax must be verified against RadiAnt's official documentation by the PACS administrator before clinical use. Built server-side; never carries patient identifiers or credentials."
    },
    "pacs_host": {
      "type": "string",
      "description": "PACS IP address or hostname, recorded from the PACS administrator for the facility's integration record. RadiAnt on each workstation retrieves the study directly from this PACS \u2014 AMedix never contacts it with DICOM networking."
    },
    "pacs_port": {
      "type": "integer",
      "description": "PACS DICOM port, typically 104 or 11112 \u2014 confirmed by the PACS administrator"
    },
    "pacs_called_ae_title": {
      "type": "string",
      "description": "PACS AE Title (the application entity queried on the facility PACS) \u2014 confirmed by the PACS administrator"
    },
    "pacs_calling_ae_title": {
      "type": "string",
      "description": "Calling AE Title the facility expects from the viewing workstation \u2014 confirmed by the PACS administrator"
    },
    "radiant_last_test_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "Result of the last Test RadiAnt Launch \u2014 { tested_datetime, outcome (launch_requested / launch_confirmed / launch_failed), confirmed (true only when the operator confirmed the correct examination opened in RadiAnt), test_study_uid, test_accession_number, launcher_name, checks: [{key, label, outcome (passed/failed/not_tested), message}], message }. A launch request is never recorded as a successful launch without the operator's confirmation."
    },
    "radiant_launch_only_test_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "Result of the LAUNCH-ONLY RadiAnt test \u2014 { tested_datetime, outcome (launch_requested / launch_only_confirmed / launch_only_failed), launch_only: true, confirmed, confirmed_datetime, confirmed_by_name, launcher_name, launch_url, checks: [{key, label, outcome, message}], message }. Records ONLY whether the installed RadiAnt application started from a bare radiant:// link: it uses no imaging request, Study Instance UID, accession number, PACS endpoint or patient information, and it never changes the facility's imaging connection status, never verifies a clinical launch and never alters what radiologists can open."
    },
    "pacs_dicomweb_base_url": {
      "type": "string",
      "description": "OPTIONAL DICOMweb (QIDO-RS) base URL of the facility PACS, used server-side to VERIFY study availability before a study is opened. Not required for RadiAnt, which retrieves studies directly from the PACS. Credentials, when the vendor requires them, are added as server-side secrets \u2014 never stored here in browser-readable form."
    },
    "pacs_dicomweb_auth_type": {
      "type": "string",
      "enum": [
        "none",
        "bearer",
        "basic"
      ],
      "default": "none",
      "description": "The facility-approved authentication method for its DICOMweb endpoint \u2014 none, Bearer token, or Basic (user:password). Recorded by the administrator from the vendor's documented requirements; the credential VALUE itself is never stored here."
    },
    "pacs_dicomweb_auth_secret_name": {
      "type": "string",
      "description": "NAME of the server-side secret holding this facility's DICOMweb service credential (e.g. PACS_ACME_TOKEN) \u2014 configured in the dashboard Secrets page. Only the secret's NAME is stored here; the value never appears in this record, the browser, URLs or logs."
    },
    "ohif_base_url": {
      "type": "string",
      "description": "HTTPS base URL of the facility's OWN deployed, approved OHIF Viewer instance \u2014 recorded by the administrator ONLY after the instance is actually deployed. May stay empty while deployment is pending; the integration then remains Pending configuration and launching stays disabled. Never the public OHIF demo, which must not receive real patient information. Used server-side to build the study route; no patient name, CIN or credential is ever placed in the URL."
    },
    "ohif_route_template": {
      "type": "string",
      "description": "Optional documented OHIF study route template overriding the default /viewer?StudyInstanceUIDs={study_instance_uid} route \u2014 placeholders {study_instance_uid} and {accession_number} only, substituted server-side. Must be https. Record only the route the deployed OHIF version documents."
    },
    "ohif_connection_status": {
      "type": "string",
      "enum": [
        "pending_configuration",
        "connected",
        "verification_failed"
      ],
      "default": "pending_configuration",
      "description": "Embedded OHIF integration state \u2014 set ONLY by the server-side end-to-end test, never by hand: pending_configuration \u2014 no deployment recorded yet, or the recorded deployment has not passed the authorized end-to-end study-retrieval test (launching disabled); connected \u2014 the test reached the deployment and retrieved studies from the facility archive; verification_failed \u2014 the last test failed. Saving any change to the integration configuration (endpoints, routes, authentication, enable state or integration type) resets the status to pending_configuration."
    },
    "ohif_connection_tested_datetime": {
      "type": "string",
      "description": "Date and time the embedded OHIF end-to-end study-retrieval test last passed (ISO datetime)"
    },
    "pacs_config_version": {
      "type": "integer",
      "default": 1,
      "description": "Version of this facility's imaging integration configuration \u2014 incremented by the server every time a relevant configuration field is changed. A version change always invalidates the previous successful verification."
    },
    "pacs_last_test_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "Result of the last server-side connection test \u2014 { tested_datetime, outcome (connected/failed/pending_configuration), simulated (true when the result is a development-mode SIMULATION, never a real verification), checks: [{key, label, outcome (passed/failed/not_tested), message}], message }. Simulated results are clearly flagged and never set the integration to Connected."
    },
    "pacs_onboarding_completed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keys of the imaging-integration onboarding checklist steps the administrator marked complete"
    },
    "pacs_vendor_notes": {
      "type": "string",
      "description": "Integration notes: vendor contact, agreed authentication method, launch capabilities confirmed by the imaging team"
    },
    "pacs_updated_datetime": {
      "type": "string",
      "description": "Date and time the imaging system connection was last changed (ISO datetime)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Hospital account status"
    }
  },
  "required": [
    "user_id",
    "hospital_name",
    "location"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}