{
  "name": "HospitalProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "hospital_name": {
      "type": "string",
      "description": "Hospital / medical center name"
    },
    "location": {
      "type": "string",
      "description": "Hospital location / address"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Hospital profile photo"
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Payment methods accepted by the hospital for patient visits, e.g. Cash, Card, Bank Transfer \u2014 configurable by the hospital"
    },
    "hospital_code": {
      "type": "string",
      "description": "Unique AMedix Hospital Code \u2014 generated by the backend with cryptographic randomness and checked for uniqueness across all hospitals. Doctors can only join the hospital with this code, never by typing the hospital name. Shown to the hospital administrator only."
    },
    "radiology_department_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this facility has a configured RADIOLOGY DEPARTMENT that receives imaging requests. When true, the administrator can open the Radiology Department Portal and doctors' imaging requests for this facility route to its worklist. When false, imaging requests for this facility are rejected with a clear routing error."
    },
    "pacs_integration_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the facility's EXISTING imaging system (PACS / RIS / web viewer) is connected to AMedix. Configured by the hospital administrator after confirming the vendor's supported integration method \u2014 never assumed. When false, radiologists see images stored in AMedix only."
    },
    "pacs_integration_type": {
      "type": "string",
      "enum": [
        "dicomweb",
        "web_viewer",
        "desktop_app",
        "ohif_embedded",
        "none"
      ],
      "default": "none",
      "description": "How the facility's existing imaging software integrates: dicomweb \u2014 DICOMweb (QIDO/WADO) endpoint verified against the vendor; web_viewer \u2014 browser viewer opened through a launch URL template; desktop_app \u2014 desktop software that cannot be embedded (studies are opened manually by reference); ohif_embedded \u2014 the facility's OWN approved OHIF Viewer deployment embedded in the Imaging Viewer tab. Set only after the vendor confirms support."
    },
    "pacs_vendor_name": {
      "type": "string",
      "description": "Vendor / product name of the facility's imaging system, recorded by the administrator for the integration record"
    },
    "pacs_viewer_url_template": {
      "type": "string",
      "description": "Vendor-documented viewer launch URL template with placeholders {study_instance_uid}, {accession_number}, {request_id}, {patient_cin}, {launch_token}. Substituted server-side only \u2014 the template and any vendor credentials never reach the browser."
    },
    "pacs_dicomweb_base_url": {
      "type": "string",
      "description": "DICOMweb (QIDO-RS) base URL of the facility PACS, used server-side to VERIFY study availability before images are marked as available. Credentials, when the vendor requires them, are added as server-side secrets \u2014 never stored here in browser-readable form."
    },
    "ohif_base_url": {
      "type": "string",
      "description": "HTTPS base URL of the facility's OWN approved OHIF Viewer deployment (e.g. https://ohif.hospital.example) \u2014 recorded by the administrator. Never the public OHIF demo, which must not receive real patient information. Used server-side to build the study route; no patient name, CIN or credential is ever placed in the URL."
    },
    "ohif_route_template": {
      "type": "string",
      "description": "Optional documented OHIF study route template overriding the default /viewer?StudyInstanceUIDs={study_instance_uid} route \u2014 placeholders {study_instance_uid} and {accession_number}, substituted server-side. Must be https. Record only the route the deployed OHIF version documents."
    },
    "pacs_vendor_notes": {
      "type": "string",
      "description": "Integration notes: vendor contact, agreed authentication method, launch capabilities confirmed by the imaging team"
    },
    "pacs_updated_datetime": {
      "type": "string",
      "description": "Date and time the imaging system connection was last changed (ISO datetime)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Hospital account status"
    }
  },
  "required": [
    "user_id",
    "hospital_name",
    "location"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}