{
  "name": "MessageThread",
  "type": "object",
  "properties": {
    "thread_ref": {
      "type": "string",
      "description": "Human-readable AMedix conversation reference, e.g. MSG-20261102-7KQ2 \u2014 generated server-side"
    },
    "channel": {
      "type": "string",
      "enum": [
        "hospital",
        "doctor",
        "patient"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "hospital",
      "description": "Which communication channel this conversation belongs to. HOSPITAL: doctor \u2194 hospital administration (two-way). DOCTOR: doctor \u2194 doctor (two-way). PATIENT: doctor \u2192 patient (strictly one-way, the patient can never reply). Existing conversations are hospital channel."
    },
    "one_way": {
      "type": "boolean",
      "default": false,
      "description": "True only for the doctor \u2192 patient channel. Enforced server-side: a patient can read the conversation but can never send into it."
    },
    "hospital_user_id": {
      "type": "string",
      "description": "User id of the hospital administrator account the conversation belongs to \u2014 the hospital isolation key. Set server-side only."
    },
    "hospital_id": {
      "type": "string",
      "description": "HospitalProfile id at the time the conversation was opened"
    },
    "hospital_name": {
      "type": "string",
      "description": "Hospital name at the time the conversation was opened"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the doctor account. For a doctor \u2194 doctor conversation this is the doctor who opened it. For a doctor \u2192 patient conversation this is the treating doctor. Set server-side, used for Row Level Security."
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the doctor in the conversation"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor name at the time the conversation was opened"
    },
    "doctor_specialization": {
      "type": "string",
      "description": "Doctor specialty / department at the affiliated hospital"
    },
    "peer_doctor_user_id": {
      "type": "string",
      "description": "Doctor \u2194 doctor conversations only: user id of the second verified doctor \u2014 set server-side when the conversation is opened by the first doctor"
    },
    "peer_doctor_id": {
      "type": "string",
      "description": "Doctor \u2194 doctor conversations only: DoctorProfile id of the second doctor"
    },
    "peer_doctor_name": {
      "type": "string",
      "description": "Doctor \u2194 doctor conversations only: name of the second doctor"
    },
    "peer_doctor_specialization": {
      "type": "string",
      "description": "Doctor \u2194 doctor conversations only: specialty of the second doctor"
    },
    "peer_doctor_hospital": {
      "type": "string",
      "description": "Doctor \u2194 doctor conversations only: hospital the second doctor works at, shown so cross-hospital colleagues are identifiable"
    },
    "patient_user_id": {
      "type": "string",
      "description": "Doctor \u2192 patient conversations only: user id of the patient account \u2014 written server-side, drives Row Level Security and lets the patient read only their own messages"
    },
    "patient_id": {
      "type": "string",
      "description": "Doctor \u2192 patient conversations only: PatientProfile id of the patient under the doctor's authorized care"
    },
    "patient_cin": {
      "type": "string",
      "description": "Doctor \u2192 patient conversations only: patient's Clinical Identification Number"
    },
    "patient_name": {
      "type": "string",
      "description": "Doctor \u2192 patient conversations only: patient full name"
    },
    "subject": {
      "type": "string",
      "description": "Conversation subject"
    },
    "category": {
      "type": "string",
      "enum": [
        "general_administration",
        "human_resources",
        "scheduling_duty_rosters",
        "finance_payments",
        "medical_administration",
        "it_support",
        "equipment_supplies",
        "complaints_suggestions",
        "general_inquiries"
      ],
      "description": "Structured communication category the conversation was opened under (hospital channel). Doctor and patient channels carry their own context and use medical_administration."
    },
    "patient_message_type": {
      "type": "string",
      "enum": [
        "follow_up",
        "appointment_reminder",
        "medication_instructions",
        "preparation_instructions",
        "post_consultation_care",
        "educational_material",
        "general"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "pink",
        "green",
        "gray",
        "gray"
      ],
      "description": "Doctor \u2192 patient conversations only: the kind of clinical instruction the first message carried, so the patient can see what the message is for"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "resolved"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green"
      ],
      "default": "pending",
      "description": "Conversation status \u2014 PENDING: awaiting hospital action. IN PROGRESS: being handled. RESOLVED: closed by the hospital (or an announcement / one-way patient message). A new message on a resolved hospital conversation reopens it and the change is recorded."
    },
    "assigned_staff_user_id": {
      "type": "string",
      "description": "User id of the responsible hospital staff member the conversation is assigned to"
    },
    "assigned_staff_name": {
      "type": "string",
      "description": "Name of the responsible staff member"
    },
    "assigned_department": {
      "type": "string",
      "description": "Administrative department the conversation is currently assigned to"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every user explicitly authorized on this conversation \u2014 for a hospital conversation the doctor, the hospital administrator and assigned staff; for a doctor conversation both doctors; for a patient conversation the doctor and the patient. Written server-side only; drives Row Level Security and real-time delivery."
    },
    "created_by_role": {
      "type": "string",
      "enum": [
        "doctor",
        "hospital",
        "patient"
      ],
      "description": "Which side opened the conversation \u2014 a patient never opens one"
    },
    "is_announcement": {
      "type": "boolean",
      "default": false,
      "description": "True when this conversation was created by a hospital announcement"
    },
    "announcement_scope": {
      "type": "string",
      "enum": [
        "hospital",
        "department"
      ],
      "description": "Announcement targeting \u2014 every affiliated doctor of the hospital, or the doctors of one department"
    },
    "target_department": {
      "type": "string",
      "description": "Department targeted by a department announcement"
    },
    "message_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of messages in the conversation"
    },
    "last_message_preview": {
      "type": "string",
      "description": "Preview of the latest message for the conversation list"
    },
    "last_message_datetime": {
      "type": "string",
      "description": "Date and time of the latest message (ISO datetime)"
    },
    "last_activity_datetime": {
      "type": "string",
      "description": "Latest activity on the conversation \u2014 a message, assignment or status change (ISO datetime)"
    },
    "doctor_unread_count": {
      "type": "integer",
      "default": 0,
      "description": "Unread messages for the starting doctor (doctor \u2194 hospital) or for the doctor who opened a doctor \u2194 doctor conversation"
    },
    "hospital_unread_count": {
      "type": "integer",
      "default": 0,
      "description": "Unread messages for the hospital side, or for the second doctor in a doctor \u2194 doctor conversation"
    },
    "patient_unread_count": {
      "type": "integer",
      "default": 0,
      "description": "Unread messages for the patient in a doctor \u2192 patient conversation"
    },
    "doctor_last_read_datetime": {
      "type": "string",
      "description": "Date and time the doctor last read the conversation (ISO datetime)"
    },
    "hospital_last_read_datetime": {
      "type": "string",
      "description": "Date and time the hospital side last read the conversation (ISO datetime)"
    },
    "patient_last_read_datetime": {
      "type": "string",
      "description": "Date and time the patient last read the doctor's message (ISO datetime)"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "by_role": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "datetime": {
            "type": "string"
          }
        },
        "required": [
          "to",
          "datetime"
        ]
      },
      "description": "Append-only record of every status change"
    },
    "assignment_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "assigned / transferred / department_assigned / unassigned"
          },
          "staff_user_id": {
            "type": "string"
          },
          "staff_name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "datetime": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "datetime"
        ]
      },
      "description": "Append-only record of administrative assignment and internal transfers"
    },
    "resolved_datetime": {
      "type": "string",
      "description": "Date and time the conversation was resolved (ISO datetime)"
    }
  },
  "required": [
    "hospital_user_id",
    "doctor_user_id",
    "subject",
    "category",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}