{
  "name": "LabRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Unique lab request reference, e.g. LR-20260907-8F3K"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "format": "date"
    },
    "patient_gender": {
      "type": "string"
    },
    "patient_blood_type": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_specialization": {
      "type": "string"
    },
    "doctor_hospital": {
      "type": "string"
    },
    "doctor_license": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "description": "All laboratory investigations included in this consolidated request",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "panel": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "indication": {
      "type": "string",
      "description": "Clinical indication / reason for testing"
    },
    "clinical_info": {
      "type": "string",
      "description": "Relevant clinical information for the laboratory"
    },
    "instructions": {
      "type": "string",
      "description": "Laboratory instructions"
    },
    "lab_name": {
      "type": "string",
      "description": "Laboratory the request is sent to"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "pending",
        "results"
      ],
      "default": "requested",
      "description": "REQUESTED: sent to laboratory. PENDING: received by laboratory, results not yet available. RESULTS: results available."
    },
    "result": {
      "type": "string"
    },
    "result_file_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "Generated PDF Lab Request Form"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_completed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "tests",
    "date_requested"
  ]
}