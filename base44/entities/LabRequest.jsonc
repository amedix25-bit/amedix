{
  "name": "LabRequest",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "test_name": {
      "type": "string"
    },
    "test_code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Lab test category, e.g. Hematology, Biochemistry"
    },
    "request_group_id": {
      "type": "string",
      "description": "Groups all tests submitted together in one electronic request"
    },
    "indication": {
      "type": "string",
      "description": "Clinical indication / reason for testing"
    },
    "instructions": {
      "type": "string",
      "description": "Laboratory instructions"
    },
    "lab_name": {
      "type": "string",
      "description": "Laboratory the request is sent to"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "completed"
      ],
      "default": "requested"
    },
    "result": {
      "type": "string"
    },
    "result_file_url": {
      "type": "string"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_completed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "test_name",
    "date_requested"
  ]
}