{
  "name": "LabRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Unique lab request reference, e.g. LR-20260907-8F3K"
    },
    "patient_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "format": "date"
    },
    "patient_gender": {
      "type": "string"
    },
    "patient_blood_type": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_specialization": {
      "type": "string"
    },
    "doctor_hospital": {
      "type": "string"
    },
    "doctor_license": {
      "type": "string"
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "signed",
        "legacy_unsigned"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "description": "SIGNED: the responsible doctor explicitly applied their professional signature, recorded server-side with the signature version and signing time \u2014 every newly issued request carries this. LEGACY_UNSIGNED: issued before mandatory signing existed; preserved unchanged and never presented as signed, never signed retrospectively without an administrator-approved migration."
    },
    "signature_record_id": {
      "type": "string",
      "description": "DoctorSignature record the signature was applied from \u2014 written server-side after verifying it belongs to the signing doctor"
    },
    "signature_version": {
      "type": "integer",
      "description": "Version of the doctor's professional signature used on this request"
    },
    "signature_reference": {
      "type": "string",
      "description": "Human-readable signature reference printed on the request form and recorded in the audit trail, e.g. SIG-V2-8F3K"
    },
    "signature_source": {
      "type": "string",
      "enum": [
        "saved_profile",
        "drawn_now",
        "uploaded_now"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink"
      ],
      "description": "How the signature was applied: SAVED_PROFILE \u2014 the doctor's saved professional signature after explicit confirmation. DRAWN_NOW \u2014 drawn on the signature pad for this request. UPLOADED_NOW \u2014 an authorised signature image uploaded for this request."
    },
    "signed_by_user_id": {
      "type": "string",
      "description": "User id of the authenticated doctor session that applied the signature \u2014 set by the server, never accepted from the browser"
    },
    "signed_by_name": {
      "type": "string",
      "description": "Full professional name of the signing doctor, set by the server from their verified profile"
    },
    "signed_by_license": {
      "type": "string",
      "description": "Professional licence number printed in the signature section, set by the server from the doctor's verified profile"
    },
    "signed_datetime": {
      "type": "string",
      "description": "Exact date and time the signature was applied (ISO datetime), set by the server"
    },
    "signature_audit": {
      "type": "array",
      "description": "Append-only record of every signature event on this request \u2014 signed, amended, cancelled",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "description": "signed / amended / cancelled"
          },
          "action_label": {
            "type": "string"
          },
          "actor_user_id": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "action"
        ]
      }
    },
    "tests": {
      "type": "array",
      "description": "All laboratory investigations included in this consolidated request",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "panel": {
            "type": "string"
          },
          "specimen": {
            "type": "string",
            "description": "Specimen type from the laboratory catalog where defined (e.g. Urine, Stool) \u2014 empty when the catalog does not specify one"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "Routine",
        "Urgent",
        "Stat"
      ],
      "default": "Routine",
      "description": "Ordering priority set by the doctor on the review screen. ROUTINE: processed in the laboratory's standard order. URGENT: flagged to the laboratory for priority attention. STAT: highest urgency \u2014 collected and processed ahead of routine work. Priority is a flag for the laboratory and does not guarantee a turnaround time; changing priority after submission follows the existing laboratory workflow."
    },
    "indication": {
      "type": "string",
      "description": "Clinical indication / reason for testing"
    },
    "clinical_info": {
      "type": "string",
      "description": "Relevant clinical information for the laboratory"
    },
    "instructions": {
      "type": "string",
      "description": "Laboratory instructions"
    },
    "lab_id": {
      "type": "string",
      "description": "Id of the LaboratoryProfile the patient authorized to view this request \u2014 the laboratory only sees the request once this is set"
    },
    "lab_name": {
      "type": "string",
      "description": "Laboratory the request is authorized to and sent to (set when the patient grants access)"
    },
    "lab_number": {
      "type": "string",
      "description": "A&M Lab Number / ID of the authorized laboratory"
    },
    "lab_location": {
      "type": "string",
      "description": "Location / address of the authorized laboratory"
    },
    "authorized_by_patient": {
      "type": "boolean",
      "default": false,
      "description": "True once the patient explicitly confirmed access for the selected laboratory"
    },
    "authorization_datetime": {
      "type": "string",
      "description": "Exact date and time the patient authorized the laboratory (ISO datetime)"
    },
    "lab_opened_at": {
      "type": "string",
      "description": "Date and time the laboratory/technician first opened this request from the notification bar (ISO datetime) \u2014 used to tell new/unread requests from opened ones"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "authorized",
        "pending",
        "results"
      ],
      "default": "requested",
      "description": "REQUESTED: created by the doctor, awaiting patient authorization. AUTHORIZED: the patient allowed a laboratory to view the request \u2014 sent to laboratory. PENDING: received by laboratory, results not yet available. RESULTS: results available."
    },
    "result": {
      "type": "string"
    },
    "result_file_url": {
      "type": "string"
    },
    "result_file_name": {
      "type": "string",
      "description": "Name of the uploaded laboratory results file"
    },
    "result_submitted_by_name": {
      "type": "string",
      "description": "Laboratory technician who submitted the results"
    },
    "specimen_collected_datetime": {
      "type": "string",
      "description": "Date and time the specimen was collected (ISO datetime) \u2014 Laboratory workflow: Request \u2192 Specimen Collected \u2192 Processing \u2192 Result \u2192 Verification \u2192 Released"
    },
    "collected_by_name": {
      "type": "string",
      "description": "Laboratory professional who collected the specimen"
    },
    "accession_number": {
      "type": "string",
      "description": "Specimen / accession number assigned by the laboratory \u2014 permanently connects the specimen and results to this request, patient, encounter and requesting doctor"
    },
    "processing_notes": {
      "type": "string",
      "description": "Test processing notes \u2014 methodology, analyzer, quality control"
    },
    "result_verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the responsible laboratory professional verified the result. Verification records the professional, date/time and verification status in the Audit Log."
    },
    "verified_by_name": {
      "type": "string",
      "description": "Laboratory professional responsible for verifying the result"
    },
    "verified_datetime": {
      "type": "string",
      "description": "Date and time the result was verified (ISO datetime)"
    },
    "released_datetime": {
      "type": "string",
      "description": "Date and time the verified result was released to the patient (ISO datetime)"
    },
    "corrected_result_file_url": {
      "type": "string",
      "description": "Corrected results PDF \u2014 corrected results NEVER overwrite the original released result; the original result and file always stay intact with complete audit history"
    },
    "corrected_result_file_name": {
      "type": "string",
      "description": "Name of the uploaded corrected results file"
    },
    "correction_reason": {
      "type": "string",
      "description": "Reason for the corrected result, entered by the laboratory"
    },
    "corrected_by_name": {
      "type": "string",
      "description": "Laboratory professional who issued the corrected result"
    },
    "corrected_datetime": {
      "type": "string",
      "description": "Date and time the corrected result was issued (ISO datetime)"
    },
    "payment_amount": {
      "type": "string",
      "description": "Payment amount collected from the patient for this laboratory request"
    },
    "payment_method": {
      "type": "string",
      "description": "How the patient paid \u2014 e.g. Cash, Card, Bank Transfer, Insurance, Mobile Wallet, Other"
    },
    "payment_datetime": {
      "type": "string",
      "description": "Date and time the payment was recorded"
    },
    "pdf_url": {
      "type": "string",
      "description": "Generated PDF Lab Request Form \u2014 for a signed request this is the final signed document and is never altered in place"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_completed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "tests",
    "date_requested"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}