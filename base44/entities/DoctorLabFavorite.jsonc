{
  "name": "DoctorLabFavorite",
  "type": "object",
  "properties": {
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id this personal favorite belongs to \u2014 for shared panels created by an administrator or hospital, the creator's user id"
    },
    "favorite_name": {
      "type": "string",
      "description": "Name the owner gave this favorite or panel, e.g. Routine Checkup, Diabetes Follow-up"
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lab catalog test ids included in this favorite or panel, across all categories \u2014 references the existing laboratory catalog, never duplicate test records"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "True for shared standardized panels \u2014 false for a doctor's personal favorites."
    },
    "hospital_user_id": {
      "type": "string",
      "description": "User id of the hospital administrator who owns this hospital-wide panel \u2014 set only for hospital panels; empty for personal favorites and legacy platform-wide shared panels. Doctors of the hospital can apply the panel through the backend-enforced panel endpoint; only the owning hospital's administrators (or a platform admin) can edit or delete it."
    },
    "hospital_name": {
      "type": "string",
      "description": "Name of the hospital this panel belongs to \u2014 display only, set at creation for hospital panels"
    }
  },
  "required": [
    "doctor_id",
    "favorite_name",
    "test_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}