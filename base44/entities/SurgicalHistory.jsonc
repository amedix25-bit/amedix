{
  "name": "SurgicalHistory",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the record is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "surgery_type": {
      "type": "string",
      "description": "Standardized English surgical terminology shown in the Doctor Portal"
    },
    "surgery_type_ar": {
      "type": "string",
      "description": "Standardized Arabic surgical term selected by the patient during registration \u2014 shown in the Patient Portal when present"
    },
    "procedure_code": {
      "type": "string",
      "description": "Procedure code from the AMedix surgical catalogue (CPT) when the selected procedure has one \u2014 recorded so the entry stays traceable to the standard name"
    },
    "procedure_specialty": {
      "type": "string",
      "description": "Surgical specialty the recorded procedure belongs to, from the AMedix surgical catalogue"
    },
    "procedure_status": {
      "type": "string",
      "enum": [
        "previous",
        "planned",
        "performed"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "previous",
      "description": "PREVIOUS: an operation the patient has already had (this is the past surgical history). PLANNED: an operation that is planned but not yet performed \u2014 never presented as completed. PERFORMED: an operation recorded as carried out"
    },
    "surgery_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "complications": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "hospitalization_duration": {
      "type": "string"
    },
    "anesthesia_history": {
      "type": "string"
    },
    "anesthesia_complications": {
      "type": "string"
    },
    "other_procedures": {
      "type": "string"
    },
    "transfusion_count": {
      "type": "string"
    },
    "transfusion_type": {
      "type": "string"
    },
    "transfusion_amount": {
      "type": "string"
    },
    "transfusion_reason": {
      "type": "string"
    },
    "transfusion_timing": {
      "type": "string"
    },
    "transfusion_reactions": {
      "type": "string"
    },
    "implants_devices": {
      "type": "string"
    }
  },
  "required": [
    "patient_id",
    "surgery_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}