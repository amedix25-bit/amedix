{
  "name": "MedicalDocument",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "prescription",
        "referral",
        "report",
        "other"
      ],
      "default": "other"
    },
    "category": {
      "type": "string",
      "enum": [
        "insurance",
        "vaccination",
        "medical_reports",
        "lab_results",
        "imaging",
        "prescriptions",
        "hospital",
        "surgical",
        "referral",
        "pathology",
        "other"
      ],
      "default": "other",
      "description": "Documents section the file is saved under \u2014 insurance card, vaccination card, or one of the additional document categories"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string",
      "description": "Original name of the captured / uploaded file"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "title",
    "type",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}