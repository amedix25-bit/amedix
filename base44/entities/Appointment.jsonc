{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set server-side when the appointment is created, used for Row Level Security so only the patient of the appointment (and their doctor) can see and manage it"
    },
    "doctor_id": {
      "type": "string"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the doctor account \u2014 set server-side when the appointment is created, used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Location / type of appointment"
    },
    "reason": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Relevant appointment details"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "patient_response": {
      "type": "string",
      "enum": [
        "accepted",
        "declined"
      ],
      "description": "The patient's ACCEPT / DECLINE response to the appointment"
    },
    "response_date": {
      "type": "string",
      "description": "Date and time the patient responded (ISO datetime)"
    },
    "original_date": {
      "type": "string",
      "format": "date",
      "description": "Original appointment date (kept when rescheduled)"
    },
    "original_time": {
      "type": "string",
      "description": "Original appointment time (kept when rescheduled)"
    },
    "rescheduled": {
      "type": "boolean",
      "default": false,
      "description": "True if this appointment has been rescheduled"
    },
    "reschedule_datetime": {
      "type": "string",
      "description": "Date and time the appointment was rescheduled (ISO datetime)"
    },
    "seen_by_doctor_id": {
      "type": "string",
      "description": "Doctor who marked the patient as seen"
    },
    "seen_by_doctor_name": {
      "type": "string",
      "description": "Name of the doctor who marked the patient as seen"
    },
    "seen_datetime": {
      "type": "string",
      "description": "Date and time the patient was seen (ISO datetime)"
    },
    "submission_id": {
      "type": "string",
      "description": "Unique client-generated appointment submission ID \u2014 the backend processes each submission only once to prevent duplicate appointments"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "date",
    "time"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}