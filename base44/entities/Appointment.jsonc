{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "doctor_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Location / type of appointment"
    },
    "reason": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Relevant appointment details"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "patient_response": {
      "type": "string",
      "enum": [
        "accepted",
        "declined"
      ],
      "description": "The patient's ACCEPT / DECLINE response to the appointment"
    },
    "response_date": {
      "type": "string",
      "description": "Date and time the patient responded (ISO datetime)"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "date",
    "time"
  ]
}