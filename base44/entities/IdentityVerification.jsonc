{
  "name": "IdentityVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User id of the account being verified \u2014 used for Row Level Security"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "patient",
        "doctor"
      ],
      "description": "Kind of profile this verification belongs to \u2014 patient or doctor"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "birth_certificate",
        "personal_card",
        "drivers_licence",
        "passport",
        "national_id",
        "medical_license",
        "professional_card"
      ],
      "description": "Selected verification document \u2014 Passport, Driver's Licence or Birth Certificate for identity (one is enough), Personal Card for legacy records, Medical License / Professional identification card for doctor credentials. The selected document decides which number the automated engine reads and compares."
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage URI of the submitted document \u2014 never public; read inside the verification function through a short-lived signed link"
    },
    "file_name": {
      "type": "string",
      "description": "Name of the submitted document"
    },
    "file_mime": {
      "type": "string",
      "description": "MIME type of the submitted document"
    },
    "file_size": {
      "type": "number",
      "description": "Size of the submitted document in bytes"
    },
    "page_count": {
      "type": "integer",
      "description": "Number of pages in the submitted document \u2014 a two-sided document is submitted as two pages of one PDF"
    },
    "source": {
      "type": "string",
      "enum": [
        "camera",
        "gallery",
        "pdf"
      ],
      "description": "How the document was acquired: CAMERA (photographed in the integrated scanner), GALLERY (an existing photo chosen from the device) or PDF (an existing PDF uploaded as it is)"
    },
    "original_file_uri": {
      "type": "string",
      "description": "Private storage URI of the original, unedited image or PDF exactly as the user provided it \u2014 preserved alongside the processed document so nothing is lost by cropping or enhancement"
    },
    "original_file_name": {
      "type": "string"
    },
    "file_uri_back": {
      "type": "string",
      "description": "Private storage URI of the back side photo of a two-sided document uploaded as a separate photo \u2014 empty when a single PDF contains both sides"
    },
    "file_name_back": {
      "type": "string",
      "description": "Original name of the back side file"
    },
    "expected_date_of_birth": {
      "type": "string",
      "description": "Date of birth as entered by the user \u2014 recorded with the automated comparison"
    },
    "extracted_date_of_birth": {
      "type": "string",
      "description": "Date of birth as read from the uploaded document by OCR"
    },
    "expected_national_id_number": {
      "type": "string",
      "description": "National ID / certificate number as entered by the user \u2014 compared automatically against the document"
    },
    "extracted_national_id_number": {
      "type": "string",
      "description": "National ID / certificate number as read from the uploaded document by OCR"
    },
    "expected_license_number": {
      "type": "string",
      "description": "Medical licence / professional number as entered by the user \u2014 compared automatically against the document"
    },
    "extracted_license_number": {
      "type": "string",
      "description": "Licence number as read from the uploaded document by OCR"
    },
    "expected_full_name": {
      "type": "string",
      "description": "Full name as entered by the user \u2014 recorded with the automated comparison"
    },
    "extracted_full_name": {
      "type": "string",
      "description": "Full name as read from the uploaded document by OCR"
    },
    "expected_personal_card_number": {
      "type": "string",
      "description": "Personal card number as entered by the user \u2014 compared automatically against the document"
    },
    "extracted_personal_card_number": {
      "type": "string",
      "description": "Personal card number as read from the uploaded document by OCR"
    },
    "expected_passport_number": {
      "type": "string",
      "description": "Passport number as entered by the user \u2014 compared automatically against the document"
    },
    "extracted_passport_number": {
      "type": "string",
      "description": "Passport number as read from the uploaded document by OCR"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "failed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "red"
      ],
      "description": "Decided automatically by the AMedix document-verification engine: VERIFIED \u2014 the number printed on the document matched the number entered, registration continues. REJECTED \u2014 the numbers did not match. FAILED \u2014 the number could not be read from the document, so a clearer document is required. PENDING exists only on legacy records submitted before the automated engine; no human decides those, and a pending record counts only when its own automated run already matched the number."
    },
    "reason": {
      "type": "string",
      "description": "Machine-readable outcome of the automated comparison \u2014 match / mismatch / unreadable (legacy values unreadable / mismatch / card_mismatch are kept unchanged)"
    },
    "verification_outcome": {
      "type": "string",
      "enum": [
        "match",
        "mismatch",
        "unreadable"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ],
      "description": "Result of the automated document-number comparison. MATCH: the number printed on the document equals the number entered. MISMATCH: they differ. UNREADABLE: the number could not be read from the document. Never set from the browser \u2014 written by the verification function."
    },
    "auto_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only when the automated engine matched the document number. An unreadable document, a mismatched number or a missing number is never treated as a match."
    },
    "engine": {
      "type": "string",
      "description": "Identifier and version of the verification engine that produced this result, e.g. amedix_document_number_v1"
    },
    "auto_check": {
      "type": "object",
      "additionalProperties": true,
      "description": "Automated document-number verification produced at submission time: { outcome: match | mismatch | unreadable, checked_datetime, engine, number_field, number_label, entered_number, read_number, normalized_entered, normalized_read, sides_read, checks: [{ field, label, entered, read, matched, decisive }], note }. The decisive check is the document number."
    },
    "review_reason": {
      "type": "string",
      "description": "Message shown to the user when the automated engine refused the document (numbers do not match, or the document could not be read). Legacy records may hold an administrator's reason."
    },
    "review_notes": {
      "type": "string",
      "description": "Legacy field \u2014 internal reviewer notes from the former manual review process. Empty on every automated decision"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Legacy field \u2014 the administrator who decided a record submitted before the automated engine existed. Empty on every automated decision"
    },
    "reviewed_datetime": {
      "type": "string",
      "description": "Legacy field \u2014 date and time of a manual decision on a record submitted before the automated engine (ISO datetime)"
    },
    "review_history": {
      "type": "array",
      "description": "Append-only automated audit trail \u2014 every event on this submission: auto_verified (number matched), auto_rejected (number did not match or could not be read), plus legacy submitted/approved/rejected events kept unchanged",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "description": "auto_verified / auto_rejected for automated decisions; submitted / document_viewed / approved / rejected on legacy records"
          },
          "actor_name": {
            "type": "string"
          },
          "actor_role": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "action"
        ]
      }
    },
    "document_access_log": {
      "type": "array",
      "description": "Legacy audit trail of document openings from the former manual review process \u2014 kept unchanged; the automated engine never exposes documents to a person",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "actor_user_id": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "side": {
            "type": "string"
          }
        },
        "required": [
          "datetime"
        ]
      }
    },
    "attempted_datetime": {
      "type": "string",
      "description": "Date and time the document was submitted (ISO datetime)"
    },
    "verified_datetime": {
      "type": "string",
      "description": "Date and time the automated engine matched the document number (ISO datetime)"
    },
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the verification documents are attached to"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id the verification documents are attached to"
    }
  },
  "required": [
    "user_id",
    "profile_type",
    "document_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}