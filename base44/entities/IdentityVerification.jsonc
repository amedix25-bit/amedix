{
  "name": "IdentityVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User id of the account being verified \u2014 used for Row Level Security"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "patient",
        "doctor"
      ],
      "description": "Kind of profile this verification belongs to \u2014 patient or doctor"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "birth_certificate",
        "personal_card",
        "drivers_licence",
        "passport",
        "national_id",
        "medical_license",
        "professional_card"
      ],
      "description": "Document category used for verification \u2014 Passport, Driver's Licence, Birth Certificate, National ID, Medical License or Professional identification card. The category is kept after verification; the document itself never is."
    },
    "document_retained": {
      "type": "boolean",
      "default": false,
      "description": "Always false under the AMedix Zero-Retention Document Verification Policy. A submitted document exists only long enough to read the number printed on it; this record never carries the document, an image, a PDF, a storage reference or a copy of its contents."
    },
    "retention_policy": {
      "type": "string",
      "description": "Retention policy the record was written under, e.g. zero_retention_v1"
    },
    "retention_method": {
      "type": "string",
      "description": "How verification was performed, e.g. automated_document_number_matching. Recorded instead of the document"
    },
    "document_purged_datetime": {
      "type": "string",
      "description": "Date and time every trace of the submitted document was removed from this record (ISO datetime)"
    },
    "file_uri": {
      "type": "string",
      "description": "LEGACY \u2014 never written by the current engine and cleared from older records by the zero-retention sweep. Storage reference of a document submitted before the policy existed"
    },
    "file_name": {
      "type": "string",
      "description": "LEGACY \u2014 never written by the current engine; cleared by the zero-retention sweep"
    },
    "file_mime": {
      "type": "string",
      "description": "LEGACY \u2014 never written by the current engine; cleared by the zero-retention sweep"
    },
    "file_size": {
      "type": "number",
      "description": "LEGACY \u2014 never written by the current engine; cleared by the zero-retention sweep"
    },
    "page_count": {
      "type": "integer",
      "description": "LEGACY \u2014 never written by the current engine; cleared by the zero-retention sweep"
    },
    "source": {
      "type": "string",
      "enum": [
        "camera",
        "gallery",
        "pdf"
      ],
      "description": "How the document was acquired: CAMERA (photographed in the integrated scanner), GALLERY (an existing photo chosen from the device) or PDF (an existing PDF uploaded as it is). Acquisition metadata only \u2014 no part of the document is kept"
    },
    "original_file_uri": {
      "type": "string",
      "description": "LEGACY \u2014 the unedited original is no longer uploaded at all; cleared from older records by the zero-retention sweep"
    },
    "original_file_name": {
      "type": "string",
      "description": "LEGACY \u2014 the unedited original is no longer uploaded at all; cleared by the zero-retention sweep"
    },
    "file_uri_back": {
      "type": "string",
      "description": "LEGACY \u2014 a two-sided document is submitted as one PDF and nothing is stored; cleared by the zero-retention sweep"
    },
    "file_name_back": {
      "type": "string",
      "description": "LEGACY \u2014 never written by the current engine; cleared by the zero-retention sweep"
    },
    "expected_date_of_birth": {
      "type": "string",
      "description": "LEGACY \u2014 cleared by the zero-retention sweep; the comparison result is kept instead"
    },
    "extracted_date_of_birth": {
      "type": "string",
      "description": "LEGACY \u2014 what the document said is never stored; cleared by the zero-retention sweep"
    },
    "expected_national_id_number": {
      "type": "string",
      "description": "National ID / certificate number, MASKED to its last four characters \u2014 enough to show the user what was compared, never a complete identifier"
    },
    "extracted_national_id_number": {
      "type": "string",
      "description": "LEGACY \u2014 what the document said is never stored; cleared by the zero-retention sweep"
    },
    "expected_license_number": {
      "type": "string",
      "description": "Medical licence / professional number, MASKED to its last four characters"
    },
    "extracted_license_number": {
      "type": "string",
      "description": "LEGACY \u2014 what the document said is never stored; cleared by the zero-retention sweep"
    },
    "expected_full_name": {
      "type": "string",
      "description": "LEGACY \u2014 cleared by the zero-retention sweep; the name lives on the patient or doctor profile, never here"
    },
    "extracted_full_name": {
      "type": "string",
      "description": "LEGACY \u2014 what the document said is never stored; cleared by the zero-retention sweep"
    },
    "expected_personal_card_number": {
      "type": "string",
      "description": "Personal card number, MASKED to its last four characters"
    },
    "extracted_personal_card_number": {
      "type": "string",
      "description": "LEGACY \u2014 what the document said is never stored; cleared by the zero-retention sweep"
    },
    "expected_passport_number": {
      "type": "string",
      "description": "Passport number, MASKED to its last four characters"
    },
    "extracted_passport_number": {
      "type": "string",
      "description": "LEGACY \u2014 what the document said is never stored; cleared by the zero-retention sweep"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "failed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "red"
      ],
      "description": "Decided automatically by the AMedix document-verification engine: VERIFIED \u2014 the number printed on the document matched the number entered, registration continues. REJECTED \u2014 the numbers did not match. FAILED \u2014 the number could not be read from the document, so a clearer document is required. PENDING exists only on legacy records submitted before the automated engine; no human decides those, and a pending record counts only when its own automated run already matched the number."
    },
    "reason": {
      "type": "string",
      "description": "Machine-readable outcome of the automated comparison \u2014 match / mismatch / unreadable (legacy values unreadable / mismatch / card_mismatch are kept unchanged)"
    },
    "verification_outcome": {
      "type": "string",
      "enum": [
        "match",
        "mismatch",
        "unreadable"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ],
      "description": "Result of the automated document-number comparison. MATCH: the number printed on the document equals the number entered. MISMATCH: they differ. UNREADABLE: the number could not be read from the document. Never set from the browser \u2014 written by the verification function."
    },
    "auto_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only when the automated engine matched the document number. An unreadable document, a mismatched number or a missing number is never treated as a match."
    },
    "engine": {
      "type": "string",
      "description": "Identifier and version of the verification engine that produced this result, e.g. amedix_document_number_v1"
    },
    "auto_check": {
      "type": "object",
      "additionalProperties": true,
      "description": "Record of the automated comparison, with every number masked: { outcome, checked_datetime, engine, number_field, number_label, entered_number (masked), read_number (masked), sides_read, checks: [{ field, label, entered (masked), read (masked), matched, decisive }], note }. No full number, and nothing else the document said, is ever written here"
    },
    "review_reason": {
      "type": "string",
      "description": "Message shown to the user when the automated engine refused the document (numbers do not match, or the document could not be read). Legacy records may hold an administrator's reason."
    },
    "review_notes": {
      "type": "string",
      "description": "Legacy field \u2014 internal reviewer notes from the former manual review process. Empty on every automated decision"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Legacy field \u2014 the administrator who decided a record submitted before the automated engine existed. Empty on every automated decision"
    },
    "reviewed_datetime": {
      "type": "string",
      "description": "Legacy field \u2014 date and time of a manual decision on a record submitted before the automated engine (ISO datetime)"
    },
    "review_history": {
      "type": "array",
      "description": "Append-only automated audit trail \u2014 every event on this submission: auto_verified (number matched), auto_rejected (number did not match or could not be read), plus legacy submitted/approved/rejected events kept unchanged",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "description": "auto_verified / auto_rejected for automated decisions; submitted / document_viewed / approved / rejected on legacy records"
          },
          "actor_name": {
            "type": "string"
          },
          "actor_role": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "action"
        ]
      }
    },
    "document_access_log": {
      "type": "array",
      "description": "Legacy audit trail of document openings from the former manual review process \u2014 kept unchanged; the automated engine never exposes documents to a person and no document exists to open",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "actor_user_id": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "side": {
            "type": "string"
          }
        },
        "required": [
          "datetime"
        ]
      }
    },
    "attempted_datetime": {
      "type": "string",
      "description": "Date and time the document was submitted (ISO datetime)"
    },
    "verified_datetime": {
      "type": "string",
      "description": "Date and time the automated engine matched the document number (ISO datetime)"
    },
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the verification belongs to"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id the verification belongs to"
    }
  },
  "required": [
    "user_id",
    "profile_type",
    "document_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}