{
  "name": "FamilyHistory",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the family history entry belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the entry is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "description": "Familial disease or medical condition in standardized English terminology \u2014 one condition per record, so a relative's conditions are never merged with another relative's"
    },
    "condition_ar": {
      "type": "string",
      "description": "Standardized Arabic term selected by the patient during registration \u2014 preserved exactly as entered and shown in the Patient Portal when present"
    },
    "relation": {
      "type": "string",
      "enum": [
        "father",
        "mother",
        "brother",
        "sister",
        "son",
        "daughter",
        "paternal_grandfather",
        "paternal_grandmother",
        "maternal_grandfather",
        "maternal_grandmother",
        "uncle",
        "aunt",
        "children",
        "other"
      ],
      "description": "Affected family member \u2014 the relative this condition belongs to. Every condition of the same relative carries the same relation, so the records group back into one family-member card. 'children' is the legacy value for a child; 'other' pairs with relation_label."
    },
    "relation_label": {
      "type": "string",
      "description": "The relationship the patient specified for 'Other relative', e.g. Cousin \u2014 kept so two different other relatives are never grouped together"
    },
    "age_at_diagnosis": {
      "type": "string",
      "description": "Approximate age of the relative at diagnosis, if known (e.g. '60s')"
    },
    "notes": {
      "type": "string",
      "description": "Any relevant notes about the family history entry"
    }
  },
  "required": [
    "patient_id",
    "condition",
    "relation"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}