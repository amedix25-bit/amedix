{
  "name": "FamilyHistory",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the family history entry belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the entry is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "description": "Familial disease or medical condition in standardized English terminology"
    },
    "condition_ar": {
      "type": "string",
      "description": "Standardized Arabic term selected by the patient during registration \u2014 preserved exactly as entered and shown in the Patient Portal when present"
    },
    "relation": {
      "type": "string",
      "enum": [
        "father",
        "mother",
        "brother",
        "sister",
        "children",
        "other"
      ],
      "description": "Affected family member \u2014 father, mother, sibling, children (when appropriate) or other relative"
    },
    "age_at_diagnosis": {
      "type": "string",
      "description": "Approximate age of the relative at diagnosis, if known (e.g. '60s')"
    },
    "notes": {
      "type": "string",
      "description": "Any relevant notes about the family history entry"
    }
  },
  "required": [
    "patient_id",
    "condition",
    "relation"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}