{
  "name": "MedicalCondition",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the record is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Standardized English medical terminology shown in the Doctor Portal"
    },
    "name_ar": {
      "type": "string",
      "description": "Standardized Arabic medical term selected by the patient during registration \u2014 shown in the Patient Portal when present"
    },
    "history_type": {
      "type": "string",
      "enum": [
        "existing_condition",
        "previous_diagnosis",
        "long_term_monitoring",
        "other"
      ],
      "default": "existing_condition",
      "description": "Structured medical-history bucket the entry belongs to \u2014 existing condition / chronic disease, previous diagnosis, long-term condition requiring monitoring, or other significant history"
    },
    "category": {
      "type": "string",
      "enum": [
        "known_case",
        "past_history"
      ],
      "default": "known_case"
    },
    "treating_facility": {
      "type": "string",
      "description": "Facility that diagnosed / treats the condition, as entered by the patient"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "being_monitored",
        "unknown"
      ],
      "description": "Current status of the condition as reported by the patient \u2014 patient-reported, never clinically verified"
    },
    "details": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}