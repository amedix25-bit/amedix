{
  "name": "MedicalCondition",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Standardized English medical terminology shown in the Doctor Portal"
    },
    "name_ar": {
      "type": "string",
      "description": "Standardized Arabic medical term selected by the patient during registration \u2014 shown in the Patient Portal when present"
    },
    "category": {
      "type": "string",
      "enum": [
        "known_case",
        "past_history"
      ],
      "default": "known_case"
    },
    "details": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "patient_id",
    "name",
    "category"
  ]
}