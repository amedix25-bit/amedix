{
  "name": "PharmacyInventory",
  "type": "object",
  "properties": {
    "pharmacy_id": {
      "type": "string",
      "description": "PharmacyProfile id this inventory item belongs to"
    },
    "pharmacy_user_id": {
      "type": "string",
      "description": "User id of the pharmacy account \u2014 used for Row Level Security"
    },
    "medication_name": {
      "type": "string",
      "description": "Drug / medication name as listed in the pharmacy's stock, e.g. Panadol"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Active ingredient (generic name), e.g. Paracetamol \u2014 doctors and patients can also match on this"
    },
    "strength": {
      "type": "string",
      "description": "Strength, e.g. 500 mg"
    },
    "dosage_form": {
      "type": "string",
      "enum": [
        "tablet",
        "capsule",
        "syrup",
        "injection",
        "cream",
        "drops",
        "other"
      ],
      "description": "Dosage form of the medication"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier / distributor the stock was received from \u2014 recorded with incoming stock receipts"
    },
    "batch_number": {
      "type": "string",
      "description": "Manufacturer batch / lot number of this stock entry \u2014 the key for expiry tracking, quarantine and recall tracing"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of the batch \u2014 expired stock is blocked from dispensing and flagged by the daily safety scan"
    },
    "price": {
      "type": "number",
      "description": "Price per unit, in LYD \u2014 shown to patients when they compare pharmacies and authorize or reserve a prescription"
    },
    "quantity_in_stock": {
      "type": "number",
      "default": 0,
      "description": "Units currently in stock \u2014 decreased when the pharmacy reserves or dispenses a prescription"
    },
    "is_quarantined": {
      "type": "boolean",
      "default": false,
      "description": "True when the batch is quarantined \u2014 expired, recalled or manually withdrawn. Quarantined stock is blocked from dispensing"
    },
    "quarantine_reason": {
      "type": "string",
      "description": "Why the batch was quarantined \u2014 e.g. expired, recalled (with the recall reference), damaged"
    },
    "quarantined_datetime": {
      "type": "string",
      "description": "Date and time the batch was quarantined (ISO datetime)"
    },
    "quarantine_action": {
      "type": "string",
      "enum": [
        "pending_disposal",
        "disposed",
        "released"
      ],
      "description": "What is being done with quarantined stock \u2014 awaiting disposal, destroyed, or released back to stock after review"
    },
    "recall_id": {
      "type": "string",
      "description": "MedicationRecall id affecting this batch \u2014 set automatically when a recall is recorded"
    },
    "recall_urgency": {
      "type": "string",
      "description": "Urgency of the recall affecting this batch \u2014 immediate, urgent or routine"
    },
    "safety_status": {
      "type": "string",
      "enum": [
        "ok",
        "expiring",
        "expired"
      ],
      "default": "ok",
      "description": "Expiry safety status computed by the daily scan \u2014 ok, expiring within 90 days, or expired"
    },
    "expiry_alerted_datetime": {
      "type": "string",
      "description": "Date and time the latest expiry alert was sent for this item (ISO datetime) \u2014 prevents duplicate alerts"
    },
    "updated_datetime": {
      "type": "string",
      "description": "Date and time the stock level was last updated (ISO datetime) \u2014 shown as the latest inventory update"
    }
  },
  "required": [
    "pharmacy_id",
    "pharmacy_user_id",
    "medication_name",
    "quantity_in_stock"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.pharmacy_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.pharmacy_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.pharmacy_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}