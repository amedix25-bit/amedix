{
  "name": "Prescription",
  "type": "object",
  "properties": {
    "prescription_id": {
      "type": "string",
      "description": "Unique AMedix prescription reference, e.g. PR-20261014-8F3K \u2014 generated at issue time, used for idempotent submission"
    },
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the prescription belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security, set server-side at issue time"
    },
    "patient_cin": {
      "type": "string",
      "description": "Patient's Clinical Identification Number \u2014 attached server-side from the unified AMedix Patient Record"
    },
    "patient_name": {
      "type": "string",
      "description": "Patient full name \u2014 attached server-side from the unified AMedix Patient Record"
    },
    "patient_dob": {
      "type": "string",
      "description": "Patient date of birth \u2014 attached server-side from the unified AMedix Patient Record"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the prescribing doctor"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the doctor account \u2014 used for Row Level Security, set server-side at issue time"
    },
    "doctor_name": {
      "type": "string",
      "description": "Prescribing doctor's name \u2014 attached server-side"
    },
    "doctor_specialization": {
      "type": "string",
      "description": "Prescribing doctor's specialization \u2014 attached server-side"
    },
    "doctor_hospital": {
      "type": "string",
      "description": "Hospital where the prescription was issued \u2014 attached server-side"
    },
    "encounter_id": {
      "type": "string",
      "description": "Encounter reference the prescription was issued during, when available"
    },
    "medication_name": {
      "type": "string",
      "description": "Drug / medication name as prescribed, e.g. Panadol"
    },
    "active_ingredient": {
      "type": "string",
      "description": "Active ingredient (generic name), e.g. Paracetamol \u2014 used to match pharmacy inventory"
    },
    "strength": {
      "type": "string",
      "description": "Strength, e.g. 500 mg \u2014 used to match pharmacy inventory"
    },
    "dosage": {
      "type": "string",
      "description": "Dosage per administration, e.g. 1 tablet"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "intravenous",
        "intramuscular",
        "subcutaneous",
        "topical",
        "inhalation",
        "rectal",
        "ophthalmic",
        "otic",
        "nasal",
        "other"
      ],
      "description": "Route of administration"
    },
    "frequency": {
      "type": "string",
      "description": "How often the medication is taken, e.g. 3 times daily"
    },
    "duration": {
      "type": "string",
      "description": "Treatment duration, e.g. 7 days"
    },
    "quantity": {
      "type": "string",
      "description": "Quantity to dispense, e.g. 21 tablets"
    },
    "refills_authorized": {
      "type": "integer",
      "default": 0,
      "description": "Number of authorized refills after the original dispense \u2014 set by the doctor at issue time"
    },
    "refills_used": {
      "type": "integer",
      "default": 0,
      "description": "Refills already dispensed by pharmacies"
    },
    "special_instructions": {
      "type": "string",
      "description": "Special instructions from the prescribing doctor, e.g. take with food"
    },
    "inhaler_device": {
      "type": "string",
      "enum": [
        "mdi",
        "dpi",
        "soft_mist",
        "nebulizer",
        "other",
        "not_applicable"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "yellow",
        "gray",
        "gray"
      ],
      "description": "Structured inhaler device selected by the prescriber for an inhaled medication: MDI (metered-dose inhaler), DPI (dry-powder inhaler), SOFT_MIST (soft-mist inhaler), NEBULIZER, OTHER, or NOT_APPLICABLE. Optional \u2014 recorded only when the prescriber selects one and never inferred from the medication name"
    },
    "inhaler_device_detail": {
      "type": "string",
      "description": "The device specified by the prescriber, e.g. the brand, a spacer / valved holding chamber for an MDI, or the device chosen under OTHER"
    },
    "inhaler_device_instructions": {
      "type": "string",
      "description": "Device-specific instructions recorded by the prescriber \u2014 priming, rinsing the mouth after use, use with a spacer, cartridge replacement, cleaning"
    },
    "technique_counselling": {
      "type": "string",
      "enum": [
        "counselled",
        "declined",
        "not_applicable"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "description": "Whether inhaler technique counselling was given during the encounter: COUNSELLED, DECLINED by the patient, or NOT_APPLICABLE. Recorded by the prescriber and never assumed"
    },
    "safety_check": {
      "type": "object",
      "additionalProperties": true,
      "description": "Medication safety check recorded at issue time \u2014 the alerts raised against the patient's record (allergies, current medications, interactions), the doctor's decision (proceeded / modified), any justified-decision note and who acknowledged it. Advisory interaction notes are marked ai_assisted; hard blocks (allergy conflicts) come from deterministic rules"
    },
    "date_prescribed": {
      "type": "string",
      "format": "date",
      "description": "Date the prescription was issued"
    },
    "prescribed_datetime": {
      "type": "string",
      "description": "Date and time the prescription was issued (ISO datetime)"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "authorized",
        "reserved",
        "dispensed",
        "cancelled"
      ],
      "default": "issued",
      "description": "ISSUED: created by the doctor, the patient has not chosen a pharmacy yet. AUTHORIZED: the patient authorized a pharmacy to dispense this prescription. RESERVED: the pharmacy confirmed a reservation for the patient. DISPENSED: the medication was dispensed to the patient. CANCELLED: the prescription was voided."
    },
    "authorized_pharmacy_id": {
      "type": "string",
      "description": "PharmacyProfile id the patient authorized to dispense this prescription \u2014 the pharmacy only sees the prescription once this is set"
    },
    "authorized_pharmacy_user_id": {
      "type": "string",
      "description": "User id of the authorized pharmacy account \u2014 used for Row Level Security"
    },
    "authorized_pharmacy_name": {
      "type": "string",
      "description": "Name of the authorized pharmacy"
    },
    "authorized_pharmacy_number": {
      "type": "string",
      "description": "A&M Pharmacy Number of the authorized pharmacy"
    },
    "authorized_pharmacy_address": {
      "type": "string",
      "description": "Location / address of the authorized pharmacy"
    },
    "authorization_datetime": {
      "type": "string",
      "description": "Date and time the patient authorized the pharmacy (ISO datetime)"
    },
    "reserved_inventory_id": {
      "type": "string",
      "description": "Id of the PharmacyInventory item (batch) whose stock the reservation holds \u2014 a rejection or cancellation returns the stock to this batch"
    },
    "reservation_code": {
      "type": "string",
      "description": "Reservation reference shown to the patient when collecting the medication, e.g. RES-8F3K2M"
    },
    "reserved_datetime": {
      "type": "string",
      "description": "Date and time the pharmacy confirmed the reservation (ISO datetime)"
    },
    "reserved_by_name": {
      "type": "string",
      "description": "Pharmacy staff member who confirmed the reservation"
    },
    "dispensed_batch_number": {
      "type": "string",
      "description": "Manufacturer batch / lot number of the stock the medication was last dispensed from \u2014 the key used to trace patients when a batch is recalled"
    },
    "dispensed_datetime": {
      "type": "string",
      "description": "Date and time the medication was last dispensed (ISO datetime)"
    },
    "dispensed_by_name": {
      "type": "string",
      "description": "Pharmacist who dispensed the medication last"
    },
    "dispensed_pharmacy_name": {
      "type": "string",
      "description": "Name of the pharmacy that dispensed the medication last"
    },
    "dispensed_quantity": {
      "type": "string",
      "description": "Quantity actually dispensed in the most recent dispense"
    },
    "total_dispensed_quantity": {
      "type": "string",
      "description": "Total quantity dispensed across all dispensing events, e.g. 14 tablets"
    },
    "dispensing_events": {
      "type": "array",
      "description": "Dispensing history \u2014 one immutable entry per Fill Prescription transaction, including partial fills, with pharmacist, pharmacy, batch number, quantity dispensed, quantity remaining, whether a refill was consumed and the submission's idempotency key. The permanent record of every dispensing transaction at the pharmacy.",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string",
            "description": "Date and time of the dispensing transaction (ISO datetime)"
          },
          "quantity": {
            "type": "string",
            "description": "Quantity dispensed in this transaction, e.g. 10 tablets"
          },
          "quantity_number": {
            "type": "number",
            "description": "Quantity dispensed in this transaction as a number"
          },
          "batch_number": {
            "type": "string",
            "description": "Manufacturer batch / lot number the medication was dispensed from"
          },
          "pharmacist_name": {
            "type": "string",
            "description": "Pharmacist who dispensed this transaction"
          },
          "pharmacy_name": {
            "type": "string",
            "description": "Pharmacy that dispensed this transaction"
          },
          "remaining_after": {
            "type": "number",
            "description": "Authorized quantity remaining after this transaction"
          },
          "consumed_refill": {
            "type": "boolean",
            "description": "True when this transaction consumed one authorized refill"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Key submitted by the client at fill time \u2014 resubmitting the same key returns the original transaction instead of dispensing again"
          }
        },
        "required": [
          "datetime",
          "quantity"
        ]
      }
    },
    "fill_count": {
      "type": "integer",
      "description": "Internal counter of recorded dispensing transactions \u2014 used as an optimistic-lock guard so two concurrent fills can never both commit against the same prescription state"
    },
    "pending_substitution": {
      "type": "object",
      "additionalProperties": true,
      "description": "Substitution awaiting the prescriber's decision \u2014 the pharmacy's proposed replacement product (same active ingredient and strength), the proposed batch and stock, the reason and who requested it. The original prescription is unchanged while this is pending; dispensing of the replacement is blocked until the doctor approves."
    },
    "substitution_history": {
      "type": "array",
      "description": "Permanent record of every approved substitution \u2014 the original medication, the replacement, the reason, the approving clinician and the timestamp. Prescriptions are never overwritten silently.",
      "items": {
        "type": "object",
        "properties": {
          "original_medication_name": {
            "type": "string",
            "description": "Medication name as originally prescribed"
          },
          "original_strength": {
            "type": "string",
            "description": "Strength as originally prescribed"
          },
          "replacement_medication_name": {
            "type": "string",
            "description": "Replacement product dispensed after the approved substitution"
          },
          "replacement_strength": {
            "type": "string",
            "description": "Strength of the replacement product"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the substitution, entered by the requesting pharmacy"
          },
          "approved_by_name": {
            "type": "string",
            "description": "Prescribing clinician who approved the substitution"
          },
          "approved_datetime": {
            "type": "string",
            "description": "Date and time the substitution was approved (ISO datetime)"
          },
          "pharmacy_name": {
            "type": "string",
            "description": "Pharmacy that requested and dispensed the substitution"
          }
        },
        "required": [
          "replacement_medication_name",
          "approved_datetime"
        ]
      }
    },
    "rejected_reason": {
      "type": "string",
      "description": "Reason the pharmacy rejected or could not fill the prescription, e.g. medication unavailable \u2014 recorded by the pharmacist"
    },
    "rejected_by_name": {
      "type": "string",
      "description": "Pharmacist who rejected the prescription"
    },
    "rejected_by_pharmacy_name": {
      "type": "string",
      "description": "Pharmacy that rejected the prescription"
    },
    "rejected_datetime": {
      "type": "string",
      "description": "Date and time the pharmacy rejected the prescription (ISO datetime)"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Reason the prescription was cancelled \u2014 entered by the cancelling doctor"
    },
    "cancelled_by_name": {
      "type": "string",
      "description": "Name of the doctor who cancelled the prescription"
    },
    "cancelled_by_role": {
      "type": "string",
      "description": "Role of who cancelled the prescription \u2014 doctor / pharmacy"
    },
    "cancelled_datetime": {
      "type": "string",
      "description": "Date and time the prescription was cancelled (ISO datetime)"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "medication_name",
    "date_prescribed"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "data.authorized_pharmacy_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}