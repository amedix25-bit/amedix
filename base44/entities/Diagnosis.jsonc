{
  "name": "Diagnosis",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the diagnosis is permanently linked to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set server-side when the diagnosis is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "doctor_id": {
      "type": "string",
      "description": "Unique DoctorProfile id of the authoring physician \u2014 used to determine ownership (My Clinical Notes vs Other Physicians' Clinical Notes); never rely on the name alone"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "diagnosis_name": {
      "type": "string",
      "description": "Name of the diagnosed condition"
    },
    "diagnosis_type": {
      "type": "string",
      "enum": [
        "Primary",
        "Secondary",
        "Provisional",
        "Differential",
        "Confirmed",
        "Chronic",
        "Acute",
        "Other"
      ],
      "description": "Type / classification of the diagnosis"
    },
    "created_datetime": {
      "type": "string",
      "description": "Date and time the diagnosis was recorded (ISO datetime, set automatically on save)"
    },
    "description": {
      "type": "string",
      "description": "Clinical notes / description of the diagnosis"
    },
    "assessment": {
      "type": "string",
      "description": "Physician's assessment"
    },
    "treatment_plan": {
      "type": "string",
      "description": "Treatment / management plan"
    },
    "icd11_code": {
      "type": "string",
      "description": "Verified ICD-11 MMS code for this diagnosis, or empty when the diagnosis has not been mapped. Never an ICD-10 code, a laboratory code, a medication identifier or a procedure code"
    },
    "icd11_display": {
      "type": "string",
      "description": "Official ICD-11 display term recorded with the code"
    },
    "icd11_system": {
      "type": "string",
      "description": "Coding system of the code \u2014 ICD-11-MMS"
    },
    "icd11_system_uri": {
      "type": "string",
      "description": "Canonical FHIR system URI for ICD-11 MMS"
    },
    "icd11_release": {
      "type": "string",
      "description": "ICD-11 release the code was verified against, e.g. 2025-01"
    },
    "icd11_source": {
      "type": "string",
      "description": "Where the code was verified \u2014 the catalogue source or the WHO browser reference entered by the clinician"
    },
    "icd11_mapping_state": {
      "type": "string",
      "enum": [
        "verified",
        "review_required",
        "unresolved"
      ],
      "description": "Mapping integrity state of this diagnosis \u2014 verified against the catalogue, entered and awaiting coding review, or unresolved with no code assigned"
    },
    "icd11_verified_date": {
      "type": "string",
      "description": "Date the code was verified against the WHO release (ISO date)"
    },
    "icd11_note_reference": {
      "type": "string",
      "description": "AMedix clinical note reference the coded diagnosis was recorded from"
    },
    "icd11_encounter_id": {
      "type": "string",
      "description": "AMedix encounter the coded diagnosis belongs to"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "diagnosis_name",
    "diagnosis_type",
    "created_datetime"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}