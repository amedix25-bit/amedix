{
  "name": "HospitalDoctor",
  "type": "object",
  "properties": {
    "hospital_id": {
      "type": "string",
      "description": "HospitalProfile id the doctor is associated with"
    },
    "hospital_name": {
      "type": "string",
      "description": "Hospital name at join time"
    },
    "hospital_user_id": {
      "type": "string",
      "description": "User id of the hospital administrator account \u2014 used for Row Level Security"
    },
    "doctor_id": {
      "type": "string",
      "description": "DoctorProfile id of the associated doctor"
    },
    "doctor_user_id": {
      "type": "string",
      "description": "User id of the doctor account \u2014 used for Row Level Security"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor full name at join time"
    },
    "doctor_photo_url": {
      "type": "string",
      "description": "Doctor profile picture at join time \u2014 the Manage Doctors view reads the live profile photo"
    },
    "specialization": {
      "type": "string",
      "description": "The doctor's specialty / department at this hospital, confirmed by the doctor when joining with the hospital code"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "rejected",
        "deactivated",
        "removed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray",
        "gray"
      ],
      "default": "pending",
      "description": "PENDING: the doctor entered this hospital's AMedix Hospital Code and is awaiting the hospital administrator's approval \u2014 no clinical access at this hospital until then. ACTIVE: the affiliation is approved and the doctor works here. REJECTED: the hospital declined the affiliation. DEACTIVATED: the hospital paused the association \u2014 it can be approved again. REMOVED: the association is ended and the doctor immediately loses access to this hospital's patients and information; re-joining requires the hospital code again."
    },
    "joined_datetime": {
      "type": "string",
      "description": "Date and time the doctor requested this affiliation (ISO datetime)"
    },
    "decided_datetime": {
      "type": "string",
      "description": "Date and time the hospital approved or rejected the affiliation (ISO datetime)"
    },
    "decided_by_name": {
      "type": "string",
      "description": "Hospital administrator who recorded the decision"
    },
    "decision_note": {
      "type": "string",
      "description": "Reason recorded by the hospital when the affiliation was rejected, shown to the doctor"
    }
  },
  "required": [
    "hospital_id",
    "hospital_name",
    "hospital_user_id",
    "doctor_id",
    "doctor_user_id",
    "doctor_name",
    "specialization",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.hospital_user_id": "{{user.id}}"
        },
        {
          "data.doctor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}