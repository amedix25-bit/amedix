{
  "name": "PartnerSubscription",
  "type": "object",
  "properties": {
    "partner_type": {
      "type": "string",
      "enum": [
        "pharmacy",
        "laboratory"
      ],
      "description": "Which portal section the partner advertises in \u2014 pharmacies advertise only in the patient Prescriptions tab, laboratories only in the Labs tab"
    },
    "partner_id": {
      "type": "string",
      "description": "PharmacyProfile / LaboratoryProfile id \u2014 the existing organization record is reused, never duplicated"
    },
    "partner_user_id": {
      "type": "string",
      "description": "User id of the pharmacy / laboratory account that owns this subscription \u2014 used for Row Level Security"
    },
    "partner_name": {
      "type": "string",
      "description": "Organization name \u2014 snapshot from the profile at subscription time"
    },
    "partner_number": {
      "type": "string",
      "description": "A&M Pharmacy / Lab Number \u2014 snapshot from the profile"
    },
    "partner_logo_url": {
      "type": "string",
      "description": "Organization logo \u2014 snapshot from the profile"
    },
    "partner_address": {
      "type": "string",
      "description": "Organization location \u2014 snapshot from the profile"
    },
    "partner_phone": {
      "type": "string",
      "description": "Organization phone \u2014 snapshot from the profile"
    },
    "partner_whatsapp": {
      "type": "string",
      "description": "Organization WhatsApp \u2014 snapshot from the profile"
    },
    "tier": {
      "type": "string",
      "enum": [
        "standard",
        "premium"
      ],
      "description": "Subscribed tier \u2014 STANDARD: approved partner profile plus an ad in the corresponding patient tab. PREMIUM: all Standard features plus featured placement (larger card, top position, premium label) in the same tab only"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "pending_approval",
      "description": "PENDING_APPROVAL: awaiting administrator approval of the partner's affiliation and subscription terms. ACTIVE: approved \u2014 the advertisement may be published after its own content review. SUSPENDED: paused by the administrator, ad hidden. CANCELLED: subscription ended"
    },
    "pending_change": {
      "type": "object",
      "additionalProperties": true,
      "description": "Partner change request awaiting the administrator \u2014 upgrade, downgrade, renewal or cancellation, with the requested tier, note, requester and the administrator's decision. One pending request at a time"
    },
    "price_amount": {
      "type": "number",
      "description": "Recurring price per billing interval, locked from the plan settings at approval \u2014 shown to the partner in billing history"
    },
    "currency": {
      "type": "string",
      "description": "Billing currency \u2014 locked from the plan settings at approval"
    },
    "billing_interval": {
      "type": "string",
      "description": "Billing interval \u2014 locked from the plan settings at approval"
    },
    "intro_months_remaining": {
      "type": "number",
      "description": "Remaining monthly payments covered by the introductory discount \u2014 decremented as discounted payments are recorded"
    },
    "intro_discount_percent": {
      "type": "number",
      "description": "Introductory discount locked at approval, e.g. 20"
    },
    "pending_upgrade_fee": {
      "type": "number",
      "description": "One-time upgrade fee currently due after moving from Standard to Premium, when the administrator configured a separate upgrade fee \u2014 cleared when a payment covering it is recorded"
    },
    "start_datetime": {
      "type": "string",
      "description": "Date and time the subscription was approved and billing started (ISO datetime)"
    },
    "next_billing_datetime": {
      "type": "string",
      "description": "Next billing date \u2014 advanced by the billing interval when a confirmed payment is recorded; ads stop showing after this date plus the grace period"
    },
    "payments": {
      "type": "array",
      "description": "Traceable billing history \u2014 one entry per payment, refund or adjustment recorded for this subscription, with who recorded it, the method, reference, verification status and idempotency key. Subscription billing is recorded through this administrator-verified ledger until automated card billing is connected",
      "items": {
        "type": "object",
        "properties": {
          "payment_id": {
            "type": "string"
          },
          "entry_type": {
            "type": "string",
            "enum": [
              "payment",
              "refund",
              "adjustment"
            ]
          },
          "datetime": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "bank_transfer",
              "card",
              "other"
            ]
          },
          "recorded_by_name": {
            "type": "string"
          },
          "recorded_by_role": {
            "type": "string"
          },
          "applies_to": {
            "type": "string",
            "enum": [
              "subscription",
              "upgrade_fee"
            ]
          },
          "payment_date": {
            "type": "string",
            "format": "date",
            "description": "Date the payment was made (ISO date) \u2014 defaults to the record date"
          },
          "payment_reference": {
            "type": "string",
            "description": "Bank transfer reference, receipt number or transaction ID supplied when recording the payment"
          },
          "verification": {
            "type": "string",
            "enum": [
              "confirmed",
              "pending_verification"
            ],
            "description": "CONFIRMED: verified by an administrator (cash and refunds/adjustments are confirmed at record time). PENDING_VERIFICATION: awaiting administrator verification \u2014 the payment does not advance billing until confirmed"
          },
          "verified_by_name": {
            "type": "string",
            "description": "Authorized verifier who confirmed the payment"
          },
          "verified_datetime": {
            "type": "string",
            "description": "Date and time the payment was verified (ISO datetime)"
          },
          "billing_applied": {
            "type": "boolean",
            "description": "True once this payment has advanced the billing date or reduced the upgrade fee \u2014 guards against double-applying"
          },
          "note": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Key submitted at record time \u2014 resubmitting the same key returns the original entry instead of creating a duplicate payment"
          }
        },
        "required": [
          "payment_id",
          "entry_type",
          "datetime",
          "amount"
        ]
      }
    },
    "payment_audit": {
      "type": "array",
      "description": "Audit trail of changes to payment status \u2014 recorded, verified, rejected \u2014 with who performed each change and when",
      "items": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "payment_id": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "action"
        ]
      }
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes from the administrator"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason the administrator suspended or cancelled the subscription"
    },
    "approved_by_name": {
      "type": "string",
      "description": "Administrator who approved the subscription"
    },
    "approved_datetime": {
      "type": "string",
      "description": "Date and time of approval (ISO datetime)"
    },
    "cancelled_datetime": {
      "type": "string",
      "description": "Date and time the subscription was cancelled (ISO datetime)"
    },
    "created_datetime": {
      "type": "string",
      "description": "Date and time the subscription was first created (ISO datetime)"
    }
  },
  "required": [
    "partner_type",
    "partner_id",
    "partner_user_id",
    "partner_name",
    "tier"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.partner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.partner_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.partner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}