{
  "name": "RadiologySettings",
  "type": "object",
  "properties": {
    "hospital_user_id": {
      "type": "string",
      "description": "Facility administrator owning these settings \u2014 hospital isolation key"
    },
    "hospital_name": {
      "type": "string"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The facility administrator (settings are an administrative surface)"
    },
    "deployment_mode": {
      "type": "string",
      "enum": [
        "demonstration",
        "verification",
        "live"
      ],
      "default": "demonstration",
      "description": "How far this facility's radiology deployment has been verified. DEMONSTRATION: fictional patients and synthetic DICOM studies only \u2014 no hospital PACS is contacted and real patient images cannot be imported. VERIFICATION: the facility's own PACS may be tested against its vendor-confirmed endpoint, real patient images still blocked. LIVE: real patients and the facility's own PACS/RadiAnt installation in clinical use. Enforced server-side on every import and PACS action."
    },
    "demo_seeded_datetime": {
      "type": "string",
      "description": "Date and time the synthetic demonstration studies were last generated (ISO datetime)"
    },
    "demo_study_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of synthetic demonstration studies generated for this facility"
    },
    "live_activated_datetime": {
      "type": "string",
      "description": "Date and time the facility was switched to live operation (ISO datetime)"
    },
    "live_activated_by_name": {
      "type": "string",
      "description": "Administrator who activated live operation"
    },
    "default_calling_ae_title": {
      "type": "string",
      "description": "Default Calling AE Title AMedix presents to this facility's PACS"
    },
    "critical_escalation_hours": {
      "type": "number",
      "default": 2,
      "description": "Hours within which an unacknowledged critical finding is escalated to the facility's clinical lead"
    },
    "report_release_policy": {
      "type": "string",
      "enum": [
        "manual_release_only",
        "auto_release_finalized"
      ],
      "default": "manual_release_only",
      "description": "Reports are never released before finalization and signature. MANUAL_RELEASE_ONLY: the department releases each final report explicitly (default). AUTO_RELEASE_FINALIZED: a finalized and signed report is released without a further step."
    },
    "audit_retention_days": {
      "type": "integer",
      "default": 365,
      "description": "Retention period recorded for this facility's radiology audit trail"
    },
    "report_footer_note": {
      "type": "string",
      "description": "Text printed on the facility's radiology report footer (accreditation, contact)"
    },
    "updated_datetime": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "hospital_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}