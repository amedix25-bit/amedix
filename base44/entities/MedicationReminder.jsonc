{
  "name": "MedicationReminder",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "PatientProfile id the reminder belongs to"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 used for Row Level Security"
    },
    "medication_id": {
      "type": "string",
      "description": "Medication record id the reminder belongs to"
    },
    "prescription_id": {
      "type": "string",
      "description": "Linked Prescription record id, when the medication came from a prescription"
    },
    "medication_name": {
      "type": "string",
      "description": "Medication name the reminder is for"
    },
    "dosage": {
      "type": "string",
      "description": "How the patient takes this dose (e.g. 1 tablet) \u2014 display only. A reminder never changes the prescribed medication or dose."
    },
    "instructions": {
      "type": "string",
      "description": "Optional patient note shown with the reminder (e.g. take with food)"
    },
    "times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reminder times each day (HH:MM, 24h) \u2014 patient-managed, pre-filled from the prescribed frequency"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "First day the reminder is active. Empty means it starts immediately."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Last day the reminder is active. Empty means it continues until the patient turns it off or the medication ends."
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Days the reminder is active, Sunday = 0 \u2026 Saturday = 6. Empty means every day."
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Tripoli",
      "description": "Timezone the reminder times are expressed in \u2014 the patient's local clinical timezone, so a schedule keeps its meaning across daylight-saving changes"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether reminders are on \u2014 the adherence system is optional, so the patient can turn reminders off at any time"
    },
    "created_datetime": {
      "type": "string",
      "description": "Date and time the reminder was created (ISO datetime)"
    },
    "notified_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dose slots already notified as YYYY-MM-DDTHH:MM \u2014 the deduplication key used by the reminder scheduler, so one slot is never alerted twice"
    },
    "snooze_slot": {
      "type": "string",
      "description": "Dose slot the patient snoozed, as YYYY-MM-DDTHH:MM. The scheduler re-alerts this slot once when snooze_until passes."
    },
    "snooze_until": {
      "type": "string",
      "description": "Date and time the snoozed dose should be alerted again (ISO datetime). Cleared once the follow-up alert is delivered."
    },
    "last_reminder_datetime": {
      "type": "string",
      "description": "Date and time the scheduler last delivered a reminder for this schedule (ISO datetime) \u2014 delivery trace for support"
    }
  },
  "required": [
    "patient_id",
    "patient_user_id",
    "medication_id",
    "medication_name",
    "times"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.patient_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}