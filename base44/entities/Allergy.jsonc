{
  "name": "Allergy",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the record is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "allergen": {
      "type": "string",
      "description": "Substance causing the reaction"
    },
    "allergy_type": {
      "type": "string",
      "enum": [
        "drug",
        "food",
        "latex",
        "contrast",
        "environmental",
        "other"
      ],
      "description": "Category of allergy \u2014 medication, food, latex, contrast-agent reaction, environmental or other"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "confirmed_allergy",
        "reported_side_effect"
      ],
      "default": "confirmed_allergy",
      "description": "CONFIRMED_ALLERGY: the patient reports a true allergy. REPORTED_SIDE_EFFECT: the patient reports an intolerance / side effect. AMedix never treats a patient entry as clinically verified \u2014 doctors must confirm"
    },
    "source": {
      "type": "string",
      "enum": [
        "patient_reported",
        "clinician_documented"
      ],
      "description": "PATIENT_REPORTED: entered by the patient \u2014 shown as reported by the patient and never presented as clinically verified. CLINICIAN_DOCUMENTED: entered by a treating doctor. Patient-reported entries never overwrite a clinician's documentation"
    },
    "reaction": {
      "type": "string",
      "description": "Reaction the patient experienced"
    },
    "severity": {
      "type": "string",
      "enum": [
        "mild",
        "moderate",
        "severe"
      ]
    },
    "approx_date": {
      "type": "string",
      "description": "Approximate date of the reaction, if known"
    },
    "treatment_required": {
      "type": "string",
      "description": "Treatment the reaction required, if any"
    }
  },
  "required": [
    "patient_id",
    "allergen"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}