{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_user_id": {
      "type": "string",
      "description": "User id of the patient account \u2014 set when the request is created and backfilled for legacy records \u2014 used for Row Level Security"
    },
    "doctor_id": {
      "type": "string"
    },
    "patient_cin": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "doctor_name": {
      "type": "string"
    },
    "doctor_specialization": {
      "type": "string"
    },
    "doctor_hospital": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "revoked",
        "suspended"
      ],
      "default": "pending",
      "description": "PENDING: doctor requested access, awaiting patient decision. APPROVED: patient accepted \u2014 doctor can view the record. DECLINED: patient declined \u2014 stays recorded so the patient can re-accept later. REVOKED: patient removed the doctor from their Doctor Access list. SUSPENDED: patient turned the eye control off \u2014 the doctor remains in the Doctor Access list but cannot view the record until access is restored."
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_responded": {
      "type": "string",
      "format": "date",
      "description": "Date the patient granted access (set when the request is accepted or re-accepted)"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "status",
    "date_requested"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.patient_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}